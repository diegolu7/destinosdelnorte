---
import "@fontsource/poppins/400.css";
import "@fontsource/poppins/500.css";
import "@fontsource/poppins/600.css";
import "@fontsource/poppins/700.css";
import "@fontsource/poppins/800.css";
import "@fontsource-variable/inter";

import "../styles/global.css";
import heroImg from "../assets/hero_img.webp";
import SeoHead from "../components/SeoHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { LOCALES, langFromPath, localeHref, type Lang } from "../lib/i18n";

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  noindex?: boolean;
  nofollow?: boolean;
  ogImage?: ImageMetadata;
  ogType?: string;
  breadcrumbs?: { name: string; path: string }[];
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  lang: langProp,
  noindex = false,
  nofollow = false,
  ogImage = heroImg,
  ogType,
  breadcrumbs,
  jsonLd,
} = Astro.props;

const base = import.meta.env.BASE_URL === "/" ? "" : import.meta.env.BASE_URL;
const lang: Lang = langProp ?? langFromPath(Astro.url.pathname);
const currentPath = Astro.url.pathname;
const alternates = (Object.keys(LOCALES) as Lang[]).map((l) => ({
  lang: l,
  href: localeHref(currentPath, l),
}));
---

<!doctype html>
<html lang={LOCALES[lang].lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <link rel="icon" href={`${base}/favicon.ico?v=3`} />
    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={LOCALES[alt.lang].lang} href={alt.href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={alternates.find((a) => a.lang === "es")?.href ?? "/"} />
    {
      import.meta.env.PROD && (
        <>
          <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-CNXSRBFY99"></script>
          <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag("js", new Date());
            gtag("config", "G-CNXSRBFY99");
          </script>
        </>
      )
    }
    {
      import.meta.env.PROD && (
        <script type="text/javascript" is:inline>
          (function (c, l, a, r, i, t, y) {
            c[a] =
              c[a] ||
              function () {
                (c[a].q = c[a].q || []).push(arguments);
              };
            t = l.createElement(r);
            t.async = 1;
            t.src = "https://www.clarity.ms/tag/" + i;
            y = l.getElementsByTagName(r)[0];
            y.parentNode.insertBefore(t, y);
          })(window, document, "clarity", "script", "ycb8sew0r9");
        </script>
      )
    }
    <SeoHead
      title={title}
      description={description}
      noindex={noindex}
      nofollow={nofollow}
      ogImage={ogImage}
      ogType={ogType}
      breadcrumbs={breadcrumbs}
      jsonLd={jsonLd}
    />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
