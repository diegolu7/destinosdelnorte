---
import SectionTitle from "./SectionTitle.astro";
import Icon from "./Icon.astro";
import { langFromPath, type Lang } from "../lib/i18n";

interface Props {
  title: string;
  comoLlegar?: string;
  mejorEpoca?: string;
  diasRecomendados?: string;
  dondeComer?: string;
  dondeAlojarse?: string;
}

const { title, comoLlegar, mejorEpoca, diasRecomendados, dondeComer, dondeAlojarse } = Astro.props;
const lang: Lang = langFromPath(Astro.url.pathname);

const LABELS: Record<Lang, Record<string, string>> = {
  es: {
    comoLlegar: "Cómo llegar",
    mejorEpoca: "Mejor época",
    dias: "Duración recomendada",
    comer: "Dónde comer",
    alojarse: "Dónde alojarse",
  },
  en: {
    comoLlegar: "How to get there",
    mejorEpoca: "Best time to visit",
    dias: "Recommended stay",
    comer: "Where to eat",
    alojarse: "Where to stay",
  },
  pt: {
    comoLlegar: "Como chegar",
    mejorEpoca: "Melhor época",
    dias: "Duração recomendada",
    comer: "Onde comer",
    alojarse: "Onde se hospedar",
  },
};

const l = LABELS[lang];
const items = [
  { icon: "pin" as const, label: l.comoLlegar, value: comoLlegar },
  { icon: "calendar" as const, label: l.mejorEpoca, value: mejorEpoca },
  { icon: "time" as const, label: l.dias, value: diasRecomendados },
  { icon: "gastronomia" as const, label: l.comer, value: dondeComer },
  { icon: "bed" as const, label: l.alojarse, value: dondeAlojarse },
].filter((item) => item.value);
---

{
  items.length > 0 && (
    <section class="mx-auto w-full max-w-6xl px-5 py-10 lg:px-8 lg:py-14">
      <SectionTitle title={title} />
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          items.map((item) => (
            <div class="flex items-start gap-4 rounded-xl bg-tarjeta p-5 shadow-card">
              <span class="mt-0.5 inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-terracota/10 text-terracota">
                <Icon name={item.icon} size={20} />
              </span>
              <div>
                <h3 class="font-display text-sm font-semibold uppercase tracking-wide text-body-light">
                  {item.label}
                </h3>
                <p class="mt-1 text-sm leading-relaxed text-body">{item.value}</p>
              </div>
            </div>
          ))
        }
      </div>
    </section>
  )
}
