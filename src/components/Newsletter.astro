---
import Icon from "./Icon.astro";
import { NEWSLETTER_ENDPOINT } from "../lib/site";
import { localeHref, type Lang } from "../lib/i18n";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;

const L = {
  es: {
    titulo: "Newsletter",
    texto: "Recibí guías y novedades del Norte en tu mail.",
    emailPh: "Tu email",
    suscribir: "Suscribirse al newsletter",
    consent:
      "Acepto recibir guías y novedades y conozco la política de privacidad.",
    privacidad: "política de privacidad",
  },
  en: {
    titulo: "Newsletter",
    texto: "Get guides and news from the North in your inbox.",
    emailPh: "Your email",
    suscribir: "Subscribe to the newsletter",
    consent:
      "I agree to receive guides and news and I know the privacy policy.",
    privacidad: "privacy policy",
  },
  pt: {
    titulo: "Newsletter",
    texto: "Receba guias e novidades do Norte no seu e-mail.",
    emailPh: "Seu e-mail",
    suscribir: "Assinar a newsletter",
    consent:
      "Aceito receber guias e novidades e conheço a política de privacidade.",
    privacidad: "política de privacidade",
  },
} as const;

const l = L[lang];
---

<div>
  <p class="font-body text-xs font-bold uppercase tracking-[0.8px] text-footer-label">{l.titulo}</p>
  <p class="mt-3 hidden text-[13px] leading-relaxed text-footer-link lg:block">
    {l.texto}
  </p>
  <form id="newsletter-form" class="mt-3" novalidate data-endpoint={NEWSLETTER_ENDPOINT} data-lang={lang}>
    <div class="flex items-center gap-0">
      <label class="sr-only" for="newsletter-email">{l.emailPh}</label>
      <input
        id="newsletter-email"
        type="email"
        name="email"
        placeholder={l.emailPh}
        required
        class="w-full min-w-0 rounded-l-lg border border-white/20 bg-white/10 px-3 py-2.5 text-sm text-white placeholder:text-navy-secondary focus:border-terracota focus:outline-none"
      />
      <button
        id="newsletter-submit"
        type="submit"
        class="inline-flex shrink-0 items-center rounded-r-lg bg-terracota px-3 py-2.5 text-white transition-colors duration-200 hover:bg-terracota-hover disabled:cursor-not-allowed disabled:opacity-60"
        aria-label={l.suscribir}
      >
        <Icon name="send" size={18} />
      </button>
    </div>
    <input
      type="text"
      name="website"
      value=""
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
      class="absolute left-[-9999px] h-0 w-0 opacity-0"
    />
    <label class="mt-3 flex items-start gap-2 text-xs text-navy-secondary">
      <input id="newsletter-consent" type="checkbox" class="mt-0.5 accent-terracota" required />
      <span>
        {l.consent.replace(l.privacidad, "")}
        <a href={localeHref("/politica-de-privacidad/", lang)} class="underline underline-offset-2 hover:text-white">
          {l.privacidad}
        </a>
      </span>
    </label>
  </form>
  <p id="newsletter-status" class="mt-2 hidden text-xs font-medium" role="status"></p>
</div>

<script>
  const form = document.getElementById("newsletter-form") as HTMLFormElement;
  const status = document.getElementById("newsletter-status");
  const consent = document.getElementById("newsletter-consent") as HTMLInputElement;
  const submitBtn = document.getElementById("newsletter-submit") as HTMLButtonElement;

  let loading = false;

  const MSG = {
    es: {
      email: "Ingresá un email válido.",
      consent: "Necesitás aceptar el consentimiento.",
      enviando: "Enviando…",
      ok: "¡Gracias! Te llegará una confirmación pronto.",
      error: "No pudimos procesar tu suscripción. Probá de nuevo.",
    },
    en: {
      email: "Please enter a valid email.",
      consent: "You need to accept the consent.",
      enviando: "Sending…",
      ok: "Thank you! A confirmation will arrive soon.",
      error: "We couldn't process your subscription. Please try again.",
    },
    pt: {
      email: "Digite um e-mail válido.",
      consent: "Você precisa aceitar o consentimento.",
      enviando: "Enviando…",
      ok: "Obrigado! Uma confirmação chegará em breve.",
      error: "Não foi possível processar sua inscrição. Tente novamente.",
    },
  } as const;

  const langEl = (form.dataset.lang ?? "es") as keyof typeof MSG;
  const msg = MSG[langEl] ?? MSG.es;

  if (form && status && consent && submitBtn) {
    function setStatus(message: string, kind: "ok" | "error" | "neutral") {
      const el = status as HTMLElement;
      el.textContent = message;
      el.classList.remove("text-green-400", "text-terracota-light", "text-white/70");
      if (kind === "ok") el.classList.add("text-green-400");
      else if (kind === "error") el.classList.add("text-terracota-light");
      else el.classList.add("text-white/70");
      el.classList.remove("hidden");
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (loading) return;

      const input = form.querySelector('input[name="email"]') as HTMLInputElement;
      const email = input.value.trim();

      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        setStatus(msg.email, "error");
        return;
      }
      if (!consent.checked) {
        setStatus(msg.consent, "error");
        return;
      }

      const ep = form.getAttribute("data-endpoint") || "";
      const dispositivo = /Android|iPhone|iPad|Mobile/i.test(navigator.userAgent)
        ? "Mobile"
        : "Desktop";
      const origen = window.location.pathname;

      loading = true;
      submitBtn.disabled = true;
      setStatus(msg.enviando, "neutral");

      try {
        const res = await fetch(ep, {
          method: "POST",
          body: JSON.stringify({ email, dispositivo, origen }),
        });
        let ok = res.ok;
        try {
          const data = await res.json();
          if (data && typeof data.ok === "boolean") ok = data.ok;
        } catch {
          /* sin JSON */
        }
        if (ok) {
          setStatus(msg.ok, "ok");
          form.reset();
        } else {
          setStatus(msg.error, "error");
        }
      } catch (err) {
        setStatus(msg.error, "error");
      } finally {
        loading = false;
        submitBtn.disabled = false;
      }
    });
  }
</script>
