---
import Icon from "./Icon.astro";
import { NEWSLETTER_ENDPOINT, NEWSLETTER_TOKEN } from "../lib/site";
---

<div>
  <p class="font-body text-xs font-bold uppercase tracking-[0.8px] text-footer-label">Newsletter</p>
  <p class="mt-3 hidden text-[13px] leading-relaxed text-footer-link lg:block">
    Recibí guías y novedades del Norte en tu mail.
  </p>
  <form id="newsletter-form" class="mt-3" novalidate data-endpoint={NEWSLETTER_ENDPOINT} data-token={NEWSLETTER_TOKEN}>
    <div class="flex items-center gap-0">
      <label class="sr-only" for="newsletter-email">Tu email</label>
      <input
        id="newsletter-email"
        type="email"
        name="email"
        placeholder="Tu email"
        required
        class="w-full min-w-0 rounded-l-lg border border-white/20 bg-white/10 px-3 py-2.5 text-sm text-white placeholder:text-navy-secondary focus:border-terracota focus:outline-none"
      />
      <button
        type="submit"
        class="inline-flex shrink-0 items-center rounded-r-lg bg-terracota px-3 py-2.5 text-white transition-colors duration-200 hover:bg-terracota-hover"
        aria-label="Suscribirse al newsletter"
      >
        <Icon name="send" size={18} />
      </button>
    </div>
    <input
      type="text"
      name="website"
      value=""
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
      class="absolute left-[-9999px] h-0 w-0 opacity-0"
    />
    <label class="mt-3 flex items-start gap-2 text-xs text-navy-secondary">
      <input id="newsletter-consent" type="checkbox" class="mt-0.5 accent-terracota" required />
      <span>
        Acepto recibir guías y novedades y conozco la{" "}
        <a href="/politica-de-privacidad/" class="underline underline-offset-2 hover:text-white">
          política de privacidad
        </a>
        .
      </span>
    </label>
  </form>
  <p id="newsletter-status" class="mt-2 hidden text-xs font-medium" role="status"></p>
</div>

<script>
  const form = document.getElementById("newsletter-form") as HTMLFormElement;
  const status = document.getElementById("newsletter-status");
  const consent = document.getElementById("newsletter-consent") as HTMLInputElement;

  if (form && status && consent) {
    function setStatus(message: string, ok: boolean) {
      status.textContent = message;
      status.classList.remove("text-green-400", "text-terracota-light");
      status.classList.add(ok ? "text-green-400" : "text-terracota-light");
      status.classList.remove("hidden");
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const input = form.querySelector('input[name="email"]') as HTMLInputElement;
      const email = input.value.trim();
      const honeypot = (form.querySelector('input[name="website"]') as HTMLInputElement).value;

      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        setStatus("Ingresá un email válido.", false);
        return;
      }
      if (!consent.checked) {
        setStatus("Necesitás aceptar el consentimiento.", false);
        return;
      }

      const ep = form.getAttribute("data-endpoint") || "";
      const token = form.getAttribute("data-token") || "";

      try {
        await fetch(ep, {
          method: "POST",
          mode: "no-cors",
          headers: { "Content-Type": "text/plain;charset=utf-8" },
          body: JSON.stringify({ email, token, website: honeypot }),
        });
        setStatus("¡Gracias! Te llegará una confirmación pronto.", true);
        form.reset();
      } catch (err) {
        setStatus("No pudimos procesar tu suscripción. Probá de nuevo.", false);
      }
    });
  }
</script>
