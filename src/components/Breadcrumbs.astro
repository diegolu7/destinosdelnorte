---
import { url } from "../lib/site";
import { langFromPath, type Lang } from "../lib/i18n";

interface Props {
  items: { name: string; path: string }[];
}

const { items } = Astro.props;
const lang: Lang = langFromPath(Astro.url.pathname);
const homeLabel = lang === "es" ? "Inicio" : lang === "pt" ? "Início" : "Home";
---

<nav aria-label="Ruta de navegación">
  <ol class="flex flex-wrap items-center gap-1.5 text-sm text-body-light">
    <li>
      <a href={url(lang === "es" ? "/" : `/${lang}/`)} class="transition-colors duration-150 hover:text-terracota">
        {homeLabel}
      </a>
    </li>
    {
      items.map((item, index) => {
        const isLast = index === items.length - 1;
        return (
          <li class="flex items-center gap-1.5">
            <span aria-hidden="true" class="text-body-light/60">/</span>
            {isLast ? (
              <span aria-current="page" class="font-medium text-navy">
                {item.name}
              </span>
            ) : (
              <a href={url(item.path)} class="transition-colors duration-150 hover:text-terracota">
                {item.name}
              </a>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
