---
import { Image } from "astro:assets";
import heroImg from "../assets/hero_img.webp";
import heroImgCafayate from "../assets/hero_img_cafayate.webp";
import heroImgPurmamarca from "../assets/hero_img_purmamarca.webp";
import heroImgTafi from "../assets/hero_img_tafi_del_valle.webp";
import Icon from "./Icon.astro";
import { url } from "../lib/site";
import { langFromPath, type Lang } from "../lib/i18n";

interface Props {
  title: string;
}

const { title } = Astro.props;
const lang: Lang = langFromPath(Astro.url.pathname);

const T = {
  es: {
    linea1: "Descubrí",
    linea2: "lo mejor del",
    linea3: "Norte Argentino",
    verSlide: "Ver slide",
    anterior: "Slide anterior",
    siguiente: "Slide siguiente",
    slides: [
      { alt: "Paisaje del Norte Argentino con montañas y cactus", texto: "Montañas de colores, pueblos con historia, cultura viva y experiencias que te van a enamorar." },
      { alt: "Viñedos de Cafayate, Salta", texto: "Vinos de altura y la Quebrada de las Conchas. — Cafayate, Salta" },
      { alt: "Cerro de los Siete Colores en Purmamarca, Jujuy", texto: "El Cerro de los Siete Colores te espera. — Purmamarca, Jujuy" },
      { alt: "Montañas del valle en Tafí del Valle, Tucumán", texto: "Naturaleza y aire puro entre montañas. — Tafí del Valle, Tucumán" },
    ],
  },
  en: {
    linea1: "Discover",
    linea2: "the best of the",
    linea3: "Argentine Northwest",
    verSlide: "View slide",
    anterior: "Previous slide",
    siguiente: "Next slide",
    slides: [
      { alt: "Landscape of the Argentine Northwest with mountains and cacti", texto: "Colorful mountains, towns with history, living culture and experiences you will love." },
      { alt: "Cafayate vineyards, Salta", texto: "High-altitude wines and the Quebrada de las Conchas. — Cafayate, Salta" },
      { alt: "Hill of Seven Colors in Purmamarca, Jujuy", texto: "The Hill of Seven Colors is waiting for you. — Purmamarca, Jujuy" },
      { alt: "Valley mountains in Tafí del Valle, Tucumán", texto: "Nature and fresh air among the mountains. — Tafí del Valle, Tucumán" },
    ],
  },
  pt: {
    linea1: "Descubra",
    linea2: "o melhor do",
    linea3: "Noroeste Argentino",
    verSlide: "Ver slide",
    anterior: "Slide anterior",
    siguiente: "Próximo slide",
    slides: [
      { alt: "Paisagem do Noroeste Argentino com montanhas e cactos", texto: "Montanhas coloridas, vilas com história, cultura viva e experiências que vão conquistar você." },
      { alt: "Vinhedos de Cafayate, Salta", texto: "Vinhos de altitude e a Quebrada de las Conchas. — Cafayate, Salta" },
      { alt: "Cerro das Sete Cores em Purmamarca, Jujuy", texto: "O Cerro das Sete Cores espera por você. — Purmamarca, Jujuy" },
      { alt: "Montanhas do vale em Tafí del Valle, Tucumán", texto: "Natureza e ar puro entre as montanhas. — Tafí del Valle, Tucumán" },
    ],
  },
} as const;

const t = T[lang];

const slides = [
  { img: heroImg, ...t.slides[0] },
  { img: heroImgCafayate, ...t.slides[1] },
  { img: heroImgPurmamarca, ...t.slides[2] },
  { img: heroImgTafi, ...t.slides[3] },
];
---

<section
  id="hero-slider"
  class="relative aspect-[1916/821] min-h-[520px] w-full max-h-[682px] overflow-hidden lg:min-h-0"
>
  {
    slides.map((slide, i) => (
      <div
        data-slide={i}
        class={`absolute inset-0 transition-opacity duration-1000 ease-in-out ${
          i === 0 ? "opacity-100" : "opacity-0"
        }`}
      >
        <Image
          src={slide.img}
          alt={slide.alt}
          width={slide.img.width}
          height={slide.img.height}
          loading={i === 0 ? "eager" : "lazy"}
          priority={i === 0}
          class="h-full w-full object-cover"
          sizes="100vw"
        />
      </div>
    ))
  }

  <div aria-hidden="true" class="hero-scrim"></div>

  <div class="absolute inset-0 flex items-center">
    <div class="mx-auto w-full max-w-6xl px-5 lg:px-8">
      <div class="max-w-2xl -translate-y-[85px] md:translate-y-0">
        <h1 class="font-display font-bold leading-tight text-white">
          <span class="block text-[28px] lg:text-[42px]">{t.linea1}</span>
          <span class="block text-[28px] lg:text-[42px]">{t.linea2}</span>
          <span class="block text-[28px] font-extrabold lg:text-[42px]">{t.linea3}</span>
        </h1>
        <div class="mt-4 grid">
          {
            slides.map((slide, i) => (
              <p
                data-text={i}
                class={`col-start-1 row-start-1 max-w-md text-sm leading-relaxed text-white/90 transition-opacity duration-1000 ease-in-out lg:text-base lg:leading-relaxed ${
                  i === 0 ? "opacity-100" : "opacity-0"
                }`}
              >
                {slide.texto}
              </p>
            ))
          }
        </div>
        <a
          href={url("/#destinos")}
          class="mt-7 inline-flex items-center justify-center rounded-lg bg-terracota px-6 py-3 text-sm font-semibold text-white shadow-button transition-colors duration-200 hover:bg-terracota-hover lg:px-6"
        >
          {title}
        </a>
      </div>
    </div>
  </div>

  <div class="absolute bottom-20 left-1/2 z-10 flex -translate-x-1/2 items-center gap-2">
    {
      slides.map((_, i) => (
        <button
          type="button"
          data-dot={i}
          aria-label={`${t.verSlide} ${i + 1}`}
          class={`h-2.5 w-2.5 rounded-full transition-colors duration-300 ${
            i === 0 ? "bg-white ring-2 ring-white/60" : "bg-white/40 ring-2 ring-white/20"
          }`}
        ></button>
      ))
    }
  </div>

  <button
    id="hero-prev"
    type="button"
    aria-label={t.anterior}
    class="absolute left-4 top-1/2 z-10 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-white text-navy shadow-card transition-transform duration-200 hover:scale-110 lg:inline-flex"
  >
    <span class="rotate-180">
      <Icon name="arrow" size={20} />
    </span>
  </button>
  <button
    id="hero-next"
    type="button"
    aria-label={t.siguiente}
    class="absolute right-4 top-1/2 z-10 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-white text-navy shadow-card transition-transform duration-200 hover:scale-110 lg:inline-flex"
  >
    <Icon name="arrow" size={20} />
  </button>
</section>

<style>
  .hero-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(
        180deg,
        rgba(6, 27, 73, 0.9) 0%,
        rgba(6, 27, 73, 0.72) 16%,
        rgba(6, 27, 73, 0.5) 28%,
        rgba(6, 27, 73, 0.26) 38%,
        rgba(6, 27, 73, 0.06) 46%,
        rgba(6, 27, 73, 0) 50%
      ),
      linear-gradient(
        90deg,
        rgba(6, 27, 73, 0.55) 0%,
        rgba(6, 27, 73, 0.2) 55%,
        rgba(6, 27, 73, 0) 100%
      );
  }

  @media (min-width: 1024px) {
    .hero-scrim {
      background: linear-gradient(
        90deg,
        rgba(6, 27, 73, 0.92) 0%,
        rgba(6, 27, 73, 0.85) 10%,
        rgba(6, 27, 73, 0.6) 22%,
        rgba(6, 27, 73, 0.32) 38%,
        rgba(6, 27, 73, 0.12) 52%,
        rgba(6, 27, 73, 0.03) 62%,
        rgba(6, 27, 73, 0) 70%
      );
    }
  }
</style>

<script>
  const slider = document.getElementById("hero-slider");
  if (!slider) throw new Error("hero-slider no encontrado");
  const slideEls = slider.querySelectorAll<HTMLElement>("[data-slide]");
  const textEls = slider.querySelectorAll<HTMLElement>("[data-text]");
  const dotEls = slider.querySelectorAll<HTMLButtonElement>("[data-dot]");
  const prevBtn = document.getElementById("hero-prev");
  const nextBtn = document.getElementById("hero-next");

  const count = slideEls.length;
  const INTERVAL = 4000;
  let current = 0;
  let timer: number | undefined;

  function show(index: number) {
    current = (index + count) % count;
    slideEls.forEach((el, i) => {
      const active = i === current;
      el.classList.toggle("opacity-100", active);
      el.classList.toggle("opacity-0", !active);
    });
    textEls.forEach((el, i) => {
      const active = i === current;
      el.classList.toggle("opacity-100", active);
      el.classList.toggle("opacity-0", !active);
    });
    dotEls.forEach((el, i) => {
      const active = i === current;
      el.classList.toggle("bg-white", active);
      el.classList.toggle("bg-white/40", !active);
      el.classList.toggle("ring-white/60", active);
      el.classList.toggle("ring-white/20", !active);
    });
  }

  function play() {
    timer = window.setInterval(() => show(current + 1), INTERVAL);
  }

  function pause() {
    if (timer !== undefined) window.clearInterval(timer);
  }

  prevBtn?.addEventListener("click", () => {
    show(current - 1);
    pause();
    play();
  });
  nextBtn?.addEventListener("click", () => {
    show(current + 1);
    pause();
    play();
  });
  dotEls.forEach((dot) => {
    dot.addEventListener("click", () => {
      show(Number(dot.dataset.dot));
      pause();
      play();
    });
  });

  slider.addEventListener("mouseenter", pause);
  slider.addEventListener("mouseleave", play);

  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (reducedMotion) {
    pause();
  } else {
    play();
  }
</script>
