---
import logo from "../assets/logo_destinos_del_norte_footer.webp";
import Icon from "./Icon.astro";
import Newsletter from "./Newsletter.astro";
import { SITE } from "../lib/site";
import { url } from "../lib/site";
import { langFromPath, localeHref, type Lang } from "../lib/i18n";

const lang: Lang = langFromPath(Astro.url.pathname);

const FOOTER = {
  es: {
    brand: "Tu guía para descubrir los lugares más increíbles del Norte Argentino.",
    destinos: "Destinos",
    guias: "Guías",
    informacion: "Información",
    queHacer: (p: string) => `Qué hacer en ${p}`,
    nosotros: "Sobre nosotros",
    contacto: "Contacto",
    faq: "Preguntas frecuentes",
    privacidad: "Política de privacidad",
  },
  en: {
    brand: "Your guide to discovering the most amazing places in the Argentine Northwest.",
    destinos: "Destinations",
    guias: "Guides",
    informacion: "Information",
    queHacer: (p: string) => `Things to do in ${p}`,
    nosotros: "About us",
    contacto: "Contact",
    faq: "FAQ",
    privacidad: "Privacy policy",
  },
  pt: {
    brand: "Seu guia para descobrir os lugares mais incríveis do Noroeste Argentino.",
    destinos: "Destinos",
    guias: "Guias",
    informacion: "Informação",
    queHacer: (p: string) => `O que fazer em ${p}`,
    nosotros: "Sobre nós",
    contacto: "Contato",
    faq: "Perguntas frequentes",
    privacidad: "Política de privacidade",
  },
} as const;

const f = FOOTER[lang];
const lh = (path: string) => localeHref(path, lang);

const columns = [
  {
    title: f.destinos,
    links: [
      { label: "Salta", href: lh("/salta/") },
      { label: "Jujuy", href: lh("/jujuy/") },
      { label: "Tucumán", href: lh("/tucuman/") },
    ],
  },
  {
    title: f.guias,
    links: [
      { label: f.queHacer("Salta"), href: lh("/salta/") },
      { label: f.queHacer("Jujuy"), href: lh("/jujuy/") },
      { label: f.queHacer("Tucumán"), href: lh("/tucuman/") },
    ],
  },
  {
    title: f.informacion,
    links: [
      { label: f.nosotros, href: "/sobre-nosotros/" },
      { label: f.contacto, href: "/contacto/" },
      { label: f.faq, href: "/preguntas-frecuentes/" },
      { label: f.privacidad, href: "/politica-de-privacidad/" },
    ],
  },
] as const;
---

<footer class="bg-navy">
  <div class="mx-auto w-full max-w-6xl px-5 pb-6 pt-8 lg:px-8 lg:pb-6 lg:pt-12">
    <div class="grid gap-8 lg:grid-cols-5 lg:gap-6">
      <div class="lg:col-span-1">
        <a href={url("/")} class="flex items-center" aria-label="Destinos del Norte — Inicio">
          <img
            src={logo.src}
            width={logo.width}
            height={logo.height}
            alt="Destinos del Norte"
            class="h-9 w-auto object-contain lg:h-11"
            loading="lazy"
          />
        </a>
        <p class="mt-4 max-w-[220px] text-[13px] leading-relaxed text-navy-secondary">
          {f.brand}
        </p>
        <a
          href={`mailto:${SITE.email}`}
          class="mt-3 inline-block break-all text-[13px] font-medium text-terracota-light transition-colors duration-150 hover:text-white"
        >
          {SITE.email}
        </a>
      </div>

      <div class="hidden gap-6 lg:grid lg:grid-cols-3 lg:col-span-3">
        {
          columns.map((column) => (
            <div>
              <p class="font-body text-xs font-bold uppercase tracking-[0.8px] text-footer-label">
                {column.title}
              </p>
              <ul class="mt-4 space-y-2.5">
                {column.links.map((link) => (
                  <li>
                    <a href={url(link.href)} class="text-[13px] text-footer-link transition-colors duration-150 hover:text-white">
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <div class="lg:col-span-1">
        <Newsletter />
      </div>
    </div>

    <div class="mt-8 flex gap-3 lg:hidden">
      {
        columns.map((column) => (
          <details class="group w-full border-t border-footer-line py-1">
            <summary class="flex cursor-pointer list-none items-center justify-between py-3">
              <span class="font-body text-xs font-bold uppercase tracking-[0.8px] text-footer-label">
                {column.title}
              </span>
              <Icon
                name="chevron"
                size={16}
                class="text-footer-label transition-transform duration-200 group-open:rotate-180"
              />
            </summary>
            <ul class="space-y-2.5 pb-4">
              {column.links.map((link) => (
                <li>
                  <a href={url(link.href)} class="text-[13px] text-footer-link transition-colors duration-150 hover:text-white">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ))
      }
    </div>

    <div class="mt-6 flex flex-col items-start justify-between gap-2 border-t border-footer-line pt-5 lg:flex-row lg:items-center">
      <p class="text-xs text-navy-secondary">
        © {new Date().getFullYear()} Destinos del Norte. Todos los derechos reservados.
      </p>
      <p class="text-xs text-navy-secondary">Salta · Jujuy · Tucumán</p>
    </div>
  </div>
</footer>
