---
import { getCollection } from "astro:content";
import Icon from "./Icon.astro";
import { url } from "../lib/site";

const experiencias = (await getCollection("experiencias"))
  .map((e) => e.data.nombre)
  .sort((a, b) => a.localeCompare(b, "es"));

const provincias = await getCollection("provincias");
const destinos = await getCollection("destinos");
const provinciaNombre = (slug: string) =>
  provincias.find((p) => p.data.slug === slug)?.data.name ?? "";

const items = [
  ...provincias.map((p) => ({
    label: p.data.name,
    sub: "Provincia",
    href: url(`/${p.data.slug}/`),
    type: "Provincia",
  })),
  ...destinos.map((d) => ({
    label: d.data.name,
    sub: provinciaNombre(d.data.provincia),
    href: url(`/${d.data.provincia}/${d.data.slug}/`),
    type: "Destino",
  })),
  ...destinos.flatMap((d) =>
    (d.data.lugaresImperdibles ?? []).map((lugar) => ({
      label: lugar.nombre,
      sub: d.data.name,
      href: url(`/${d.data.provincia}/${d.data.slug}/`),
      type: "Lugar",
    })),
  ),
];
---

<div id="buscador" class="relative z-10 scroll-mt-24 px-5 pb-4 lg:px-8 lg:pb-6">
  <div class="mx-auto max-w-6xl rounded-[14px] bg-header p-3 shadow-search sm:p-4">
    <form
      action={url("/busqueda/")}
      method="get"
      class="flex flex-col gap-2 sm:flex-row sm:items-center"
      role="search"
    >
      <label class="relative flex flex-1 items-center gap-2 rounded-[10px] border border-border-input bg-header px-4 py-3">
        <Icon name="pin" size={20} class="shrink-0 text-terracota" />
        <span class="sr-only">Destino</span>
        <input
          type="text"
          name="q"
          id="busqueda-q"
          role="combobox"
          aria-autocomplete="list"
          aria-expanded="false"
          aria-controls="busqueda-sugerencias"
          aria-label="¿A dónde querés ir?"
          placeholder="¿A dónde querés ir?"
          autocomplete="off"
          data-items={JSON.stringify(items)}
          class="w-full bg-transparent text-sm text-navy placeholder:text-body-light focus:outline-none"
        />
        <ul
          id="busqueda-sugerencias"
          role="listbox"
          aria-label="Sugerencias"
          hidden
          class="absolute left-0 right-0 top-full z-20 mt-2 max-h-72 overflow-auto rounded-xl bg-header p-1.5 shadow-card"
        ></ul>
      </label>

      <label class="relative flex flex-1 items-center gap-2 rounded-[10px] border border-border-input bg-header px-4 py-3 opacity-60">
        <Icon name="calendar" size={20} class="shrink-0 text-body-light" />
        <span class="sr-only">Fecha</span>
        <input
          type="text"
          name="fecha"
          placeholder="¿Cuándo?"
          disabled
          class="w-full cursor-not-allowed bg-transparent text-sm text-navy placeholder:text-body-light focus:outline-none"
        />
      </label>

      <label class="relative flex flex-1 items-center gap-2 rounded-[10px] border border-border-input bg-header px-4 py-3">
        <Icon name="filter" size={20} class="shrink-0 text-terracota" />
        <span class="sr-only">Tipo de experiencia</span>
        <select
          name="tipo"
          class="w-full appearance-none bg-transparent text-sm text-body-light focus:outline-none"
        >
          <option value="" selected>Tipo de experiencia</option>
          {
            experiencias.map((nombre) => (
              <option value={nombre}>{nombre}</option>
            ))
          }
        </select>
        <Icon name="chevron" size={16} class="pointer-events-none shrink-0 text-body-light" />
      </label>

      <button
        type="submit"
        class="inline-flex items-center justify-center gap-2 rounded-lg bg-navy px-6 py-3 text-sm font-semibold text-white transition-colors duration-200 hover:bg-navy-deeper"
      >
        <Icon name="search" size={18} />
        Buscar
      </button>
    </form>
  </div>
</div>

<script is:inline>
  const input = document.getElementById("busqueda-q");
  const list = document.getElementById("busqueda-sugerencias");
  const form = input.closest("form");
  const items = JSON.parse(input.getAttribute("data-items") || "[]");

  const MAX = 7;
  let matches = [];
  let active = -1;

  function normalize(value) {
    return String(value)
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "");
  }

  function render() {
    const q = normalize(input.value.trim());
    matches = [];
    if (!q) {
      list.hidden = true;
      input.setAttribute("aria-expanded", "false");
      return;
    }
    for (const item of items) {
      const hay = normalize(item.label + " " + item.sub);
      if (hay.includes(q)) matches.push(item);
      if (matches.length >= MAX) break;
    }
    if (matches.length === 0) {
      list.innerHTML = "";
      list.hidden = true;
      input.setAttribute("aria-expanded", "false");
      return;
    }
    list.hidden = false;
    input.setAttribute("aria-expanded", "true");
    list.innerHTML = matches
      .map(
        (item, i) =>
          `<li role="option" id="busq-opt-${i}" data-i="${i}" class="flex cursor-pointer items-center justify-between gap-3 rounded-lg px-3 py-2 text-sm ${i === 0 ? "bg-page" : ""}">
             <span class="min-w-0">
               <span class="block truncate font-medium text-navy">${item.label}</span>
               <span class="block truncate text-xs text-body-light">${item.type} · ${item.sub}</span>
             </span>
           </li>`,
      )
      .join("");
    active = 0;
    mark(0);
  }

  function mark(i) {
    const opts = list.querySelectorAll("[role=option]");
    opts.forEach((o, idx) => o.classList.toggle("bg-page", idx === i));
    if (opts[i]) input.setAttribute("aria-activedescendant", opts[i].id);
  }

  function select(i) {
    const item = matches[i];
    if (!item) return;
    input.value = item.label;
    list.hidden = true;
    input.setAttribute("aria-expanded", "false");
    form.submit();
  }

  input.addEventListener("input", render);

  input.addEventListener("keydown", (e) => {
    if (matches.length === 0) return;
    if (e.key === "ArrowDown") {
      e.preventDefault();
      active = (active + 1) % matches.length;
      mark(active);
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      active = (active - 1 + matches.length) % matches.length;
      mark(active);
    } else if (e.key === "Enter") {
      if (active >= 0 && matches[active]) {
        e.preventDefault();
        select(active);
      }
    } else if (e.key === "Escape") {
      list.hidden = true;
      input.setAttribute("aria-expanded", "false");
    }
  });

  list.addEventListener("mousedown", (e) => {
    const li = e.target.closest("[data-i]");
    if (li) select(Number(li.dataset.i));
  });

  input.addEventListener("blur", () => {
    setTimeout(() => {
      list.hidden = true;
      input.setAttribute("aria-expanded", "false");
    }, 120);
  });
</script>
