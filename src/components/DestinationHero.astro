---
import { Image } from "astro:assets";
import Breadcrumbs from "./Breadcrumbs.astro";
import { url } from "../lib/site";

interface Props {
  titulo: string;
  intro: string;
  provinciaName: string;
  provinciaHref: string;
  imagen: ImageMetadata;
  imagenAlt: string;
  breadcrumbs: { name: string; path: string }[];
}

const { titulo, intro, provinciaName, provinciaHref, imagen, imagenAlt, breadcrumbs } = Astro.props;
---

<section class="mx-auto w-full max-w-6xl px-5 py-8 lg:px-8 lg:py-12">
  <Breadcrumbs items={breadcrumbs} />

  <div class="mt-6 grid items-center gap-8 lg:grid-cols-2">
    <div>
      <a
        href={url(provinciaHref)}
        class="inline-flex items-center gap-1.5 rounded-full bg-terracota/10 px-3 py-1 text-xs font-semibold text-terracota transition-colors duration-200 hover:bg-terracota/20"
      >
        {provinciaName}
      </a>
      <h1 class="mt-4 font-display text-3xl font-bold leading-tight text-navy lg:text-[42px]">
        {titulo}
      </h1>
      <p class="mt-4 max-w-xl text-sm leading-relaxed text-body lg:text-base">{intro}</p>
    </div>

    <div class="overflow-hidden rounded-2xl shadow-card">
      <Image
        src={imagen}
        alt={imagenAlt}
        width={640}
        height={591}
        loading="eager"
        priority
        class="h-auto w-full object-cover"
      />
    </div>
  </div>
</section>
