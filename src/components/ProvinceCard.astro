---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";

interface Props {
  nombre: string;
  slug: string;
  imagen: ImageMetadata;
}

const { nombre, slug, imagen } = Astro.props;
---

<a
  href={`/${slug}/`}
  class="group relative block aspect-[4/3] overflow-hidden rounded-2xl bg-tarjeta shadow-card transition-all duration-200 ease-out hover:-translate-y-1 hover:shadow-card-hover"
>
  <Image
    src={imagen}
    alt={`Qué hacer en ${nombre}`}
    width={1448}
    height={1086}
    loading="lazy"
    class="h-full w-full object-cover"
  />
  <div aria-hidden="true" class="overlay-card absolute inset-0"></div>
  <div class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-1.5 p-2 lg:gap-3 lg:p-4">
    <div>
      <p class="font-display text-[9px] font-medium text-white sm:text-[11px] lg:text-[13px]">
        Qué hacer en
      </p>
      <p class="font-display text-[11px] font-bold text-white sm:text-sm lg:text-xl">{nombre}</p>
    </div>
    <span
      class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-white text-navy transition-transform duration-200 group-hover:scale-110 sm:h-10 sm:w-10 lg:h-11 lg:w-11"
      aria-hidden="true"
    >
      <Icon name="arrow" size={16} />
    </span>
  </div>
</a>
