---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import { url } from "../lib/site";
import { localeHref, type Lang } from "../lib/i18n";

interface Props {
  nombre: string;
  slug: string;
  imagen: ImageMetadata;
  lang?: Lang;
}

const { nombre, slug, imagen, lang = "es" } = Astro.props;

const queHacer = { es: "Qué hacer en", en: "Things to do in", pt: "O que fazer em" } as const;
const imgAlt = `${queHacer[lang]} ${nombre}`;
---

<a
  href={url(localeHref(`/${slug}/`, lang))}
  class="group relative block h-28 overflow-hidden rounded-2xl bg-tarjeta shadow-card transition-all duration-200 ease-out hover:-translate-y-1 hover:shadow-card-hover sm:h-auto sm:aspect-[4/3]"
>
  <Image
    src={imagen}
    alt={imgAlt}
    width={1448}
    height={1086}
    loading="lazy"
    class="absolute inset-0 h-full w-full object-cover object-bottom"
  />
  <div aria-hidden="true" class="overlay-card absolute inset-0"></div>
  <div class="absolute inset-0 flex items-center justify-between gap-3 p-4 sm:items-end">
    <div>
      <p class="font-display text-[11px] font-medium text-white sm:text-[11px] lg:text-[13px]">
        {queHacer[lang]}
      </p>
      <p class="font-display text-sm font-bold text-white sm:text-sm lg:text-xl">{nombre}</p>
    </div>
    <span
      class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white text-navy transition-transform duration-200 group-hover:scale-110 sm:h-10 sm:w-10 lg:h-11 lg:w-11"
      aria-hidden="true"
    >
      <Icon name="arrow" size={18} />
    </span>
  </div>
</a>

