---
import { getCollection } from "astro:content";
import logo from "../assets/logo_destinos_del_norte.webp";
import Icon from "./Icon.astro";
import { url } from "../lib/site";

const provincias = (await getCollection("provincias")).sort((a, b) =>
  a.data.name.localeCompare(b.data.name, "es"),
);

const guiasProvincias = provincias.map((p) => ({
  label: p.data.name,
  href: url(`/${p.data.slug}/`),
}));

const navMain = [
  { label: "Qué hacer", href: "/#que-hacer" },
  { label: "Destinos", href: "/#destinos" },
];
---

<header class="sticky top-0 z-50 border-b border-border-input bg-header">
  <div class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between gap-4 px-5 lg:h-20 lg:px-8">
    <a href={url("/")} class="flex items-center" aria-label="Destinos del Norte — Inicio">
      <img
        src={logo.src}
        width={logo.width}
        height={logo.height}
        alt="Destinos del Norte"
        class="h-8 w-auto object-contain lg:h-10"
        loading="eager"
      />
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Navegación principal">
      {
        navMain.map((link) => (
          <a
            href={url(link.href)}
            class="text-sm font-medium text-navy transition-colors duration-200 hover:text-terracota"
          >
            {link.label}
          </a>
        ))
      }

      <div class="relative group">
        <button
          type="button"
          aria-haspopup="true"
          aria-expanded="false"
          class="flex items-center gap-1 text-sm font-medium text-navy transition-colors duration-200 group-hover:text-terracota group-focus-within:text-terracota focus:outline-none"
        >
          Guías de viaje
          <Icon
            name="chevron"
            size={14}
            class="shrink-0 transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180"
          />
        </button>
        <ul
          role="menu"
          aria-label="Guías por provincia"
          class="invisible absolute left-0 top-full z-20 mt-3 w-52 translate-y-1 rounded-xl bg-header p-1.5 opacity-0 shadow-card transition-all duration-150 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100"
        >
          {
            guiasProvincias.map((p) => (
              <li role="none">
                <a
                  role="menuitem"
                  href={p.href}
                  class="block rounded-lg px-3 py-2 text-sm text-navy transition-colors duration-150 hover:bg-page hover:text-terracota"
                >
                  {p.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <a
        href={url("/rutas/")}
        class="text-sm font-medium text-navy transition-colors duration-200 hover:text-terracota"
      >
        Rutas
      </a>
      <a
        href={url("/blog/")}
        class="text-sm font-medium text-navy transition-colors duration-200 hover:text-terracota"
      >
        Blog
      </a>
      <a
        href={url("/contacto/")}
        class="text-sm font-medium text-navy transition-colors duration-200 hover:text-terracota"
      >
        Contacto
      </a>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={url("/#buscador")}
        class="hidden rounded-full p-2 text-navy transition-colors duration-200 hover:text-terracota lg:inline-flex"
        aria-label="Buscar destinos"
      >
        <Icon name="search" size={22} />
      </a>
      <button
        id="menu-toggle"
        type="button"
        class="inline-flex rounded-full p-2 text-navy transition-colors duration-200 hover:text-terracota lg:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" size={24} />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-border-input bg-header lg:hidden">
    <nav class="flex flex-col px-5 py-4" aria-label="Navegación móvil">
      {
        navMain.map((link) => (
          <a
            href={url(link.href)}
            class="border-b border-border-input py-3 text-sm font-medium text-navy transition-colors duration-200 last:border-0 hover:text-terracota"
          >
            {link.label}
          </a>
        ))
      }
      <details class="group border-b border-border-input">
        <summary class="flex cursor-pointer list-none items-center justify-between py-3 text-sm font-medium text-navy">
          Guías de viaje
          <Icon
            name="chevron"
            size={16}
            class="shrink-0 text-body-light transition-transform duration-200 group-open:rotate-180"
          />
        </summary>
        <ul class="space-y-1 pb-3">
          {
            guiasProvincias.map((p) => (
              <li>
                <a
                  href={p.href}
                  class="block py-1.5 text-sm text-navy transition-colors duration-150 hover:text-terracota"
                >
                  {p.label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
      <a
        href={url("/rutas/")}
        class="border-b border-border-input py-3 text-sm font-medium text-navy transition-colors duration-200 hover:text-terracota"
      >
        Rutas
      </a>
      <a
        href={url("/blog/")}
        class="border-b border-border-input py-3 text-sm font-medium text-navy transition-colors duration-200 hover:text-terracota"
      >
        Blog
      </a>
      <a
        href={url("/contacto/")}
        class="border-b border-border-input py-3 text-sm font-medium text-navy transition-colors duration-200 hover:text-terracota"
      >
        Contacto
      </a>
      <a
        href={url("/#buscador")}
        class="mt-2 inline-flex items-center gap-2 py-3 text-sm font-medium text-navy transition-colors duration-200 hover:text-terracota"
      >
        <Icon name="search" size={20} />
        Buscar
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");

  if (toggle && menu) {
    toggle.addEventListener("click", () => {
      const open = menu.classList.toggle("hidden") === false;
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    });
  }
</script>
