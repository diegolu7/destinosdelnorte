---
import Icon from "./Icon.astro";
import { CONTACT_ENDPOINT, SITE } from "../lib/site";
import { localeHref, type Lang } from "../lib/i18n";

interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;

const L = {
  es: {
    nombre: "Nombre",
    nombrePh: "Tu nombre",
    email: "Email",
    emailPh: "tu@email.com",
    mensaje: "Mensaje",
    mensajePh: "Contanos tu consulta…",
    consent: "Acepto las políticas de privacidad.",
    privacidad: "políticas de privacidad",
    enviar: "Enviar consulta",
    directo: "¿Preferís escribirnos directo?",
  },
  en: {
    nombre: "Name",
    nombrePh: "Your name",
    email: "Email",
    emailPh: "you@email.com",
    mensaje: "Message",
    mensajePh: "Tell us your question…",
    consent: "I accept the privacy policy.",
    privacidad: "privacy policy",
    enviar: "Send message",
    directo: "Prefer to write to us directly?",
  },
  pt: {
    nombre: "Nome",
    nombrePh: "Seu nome",
    email: "E-mail",
    emailPh: "voce@email.com",
    mensaje: "Mensagem",
    mensajePh: "Conte-nos sua dúvida…",
    consent: "Aceito a política de privacidade.",
    privacidad: "política de privacidade",
    enviar: "Enviar mensagem",
    directo: "Prefere escrever diretamente?",
  },
} as const;

const l = L[lang];
---

<div class="rounded-2xl bg-tarjeta p-6 shadow-card sm:p-8">
  <form id="contact-form" class="space-y-4" novalidate data-endpoint={CONTACT_ENDPOINT} data-lang={lang}>
    <div>
      <label for="contact-nombre" class="mb-1 block text-sm font-medium text-navy">{l.nombre}</label>
      <input
        id="contact-nombre"
        name="nombre"
        type="text"
        required
        autocomplete="name"
        class="w-full rounded-[10px] border border-border-input bg-header px-4 py-3 text-sm text-navy placeholder:text-body-light focus:border-terracota focus:outline-none"
        placeholder={l.nombrePh}
      />
    </div>

    <div>
      <label for="contact-email" class="mb-1 block text-sm font-medium text-navy">{l.email}</label>
      <input
        id="contact-email"
        name="email"
        type="email"
        required
        autocomplete="email"
        class="w-full rounded-[10px] border border-border-input bg-header px-4 py-3 text-sm text-navy placeholder:text-body-light focus:border-terracota focus:outline-none"
        placeholder={l.emailPh}
      />
    </div>

    <div>
      <label for="contact-mensaje" class="mb-1 block text-sm font-medium text-navy">{l.mensaje}</label>
      <textarea
        id="contact-mensaje"
        name="mensaje"
        rows={5}
        required
        class="w-full resize-y rounded-[10px] border border-border-input bg-header px-4 py-3 text-sm text-navy placeholder:text-body-light focus:border-terracota focus:outline-none"
        placeholder={l.mensajePh}
      ></textarea>
    </div>

    <input
      type="text"
      name="website"
      value=""
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
      class="absolute left-[-9999px] h-0 w-0 opacity-0"
    />

    <label class="flex items-start gap-2 text-xs text-body-light">
      <input id="contact-consent" type="checkbox" class="mt-0.5 accent-terracota" required />
      <span>
        {l.consent.replace(l.privacidad, "")}
        <a
          href={localeHref("/politica-de-privacidad/", lang)}
          class="font-medium text-terracota underline underline-offset-2 hover:text-terracota-hover"
        >
          {l.privacidad}
        </a>
      </span>
    </label>

    <button
      id="contact-submit"
      type="submit"
      class="inline-flex items-center justify-center gap-2 rounded-lg bg-terracota px-6 py-3 text-sm font-semibold text-white shadow-button transition-colors duration-200 hover:bg-terracota-hover disabled:cursor-not-allowed disabled:opacity-60"
    >
      <Icon name="send" size={18} />
      {l.enviar}
    </button>
    <p id="contact-status" class="hidden text-xs font-medium" role="status"></p>
  </form>

  <div class="mt-6 border-t border-border-card pt-5">
    <p class="text-xs text-body-light">{l.directo}</p>
    <a href={`mailto:${SITE.email}`} class="mt-1 inline-block text-sm font-medium text-terracota hover:text-terracota-hover">
      {SITE.email}
    </a>
  </div>
</div>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const status = document.getElementById("contact-status");
  const consent = document.getElementById("contact-consent") as HTMLInputElement;
  const submitBtn = document.getElementById("contact-submit") as HTMLButtonElement;
  const statusEl = status as HTMLElement;
  let loading = false;

  const MSG = {
    es: {
      nombre: "Ingresá tu nombre.",
      email: "Ingresá un email válido.",
      mensaje: "Escribí tu consulta.",
      consent: "Necesitás aceptar el tratamiento de tus datos.",
      desconectado: "El formulario aún no está conectado. Volvé a intentar más tarde.",
      enviando: "Enviando…",
      ok: "¡Gracias! Tu consulta fue enviada.",
      error: "No pudimos enviar tu consulta. Probá de nuevo.",
    },
    en: {
      nombre: "Please enter your name.",
      email: "Please enter a valid email.",
      mensaje: "Please write your message.",
      consent: "You need to accept how your data is processed.",
      desconectado: "The form is not connected yet. Please try again later.",
      enviando: "Sending…",
      ok: "Thank you! Your message was sent.",
      error: "We couldn't send your message. Please try again.",
    },
    pt: {
      nombre: "Digite seu nome.",
      email: "Digite um e-mail válido.",
      mensaje: "Escreva sua mensagem.",
      consent: "Você precisa aceitar o tratamento dos seus dados.",
      desconectado: "O formulário ainda não está conectado. Tente novamente mais tarde.",
      enviando: "Enviando…",
      ok: "Obrigado! Sua mensagem foi enviada.",
      error: "Não foi possível enviar sua mensagem. Tente novamente.",
    },
  } as const;

  const langEl = (form.dataset.lang ?? "es") as keyof typeof MSG;
  const msg = MSG[langEl] ?? MSG.es;

  function setStatus(message: string, kind: "ok" | "error" | "neutral") {
    statusEl.textContent = message;
    statusEl.classList.remove("text-green-600", "text-terracota", "text-body-light");
    if (kind === "ok") statusEl.classList.add("text-green-600");
    else if (kind === "error") statusEl.classList.add("text-terracota");
    else statusEl.classList.add("text-body-light");
    statusEl.classList.remove("hidden");
  }

  if (form && status && consent && submitBtn) {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (loading) return;

      const nombre = (form.querySelector('[name="nombre"]') as HTMLInputElement).value.trim();
      const email = (form.querySelector('[name="email"]') as HTMLInputElement).value.trim();
      const mensaje = (form.querySelector('[name="mensaje"]') as HTMLTextAreaElement).value.trim();

      if (!nombre) {
        setStatus(msg.nombre, "error");
        return;
      }
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        setStatus(msg.email, "error");
        return;
      }
      if (!mensaje) {
        setStatus(msg.mensaje, "error");
        return;
      }
      if (!consent.checked) {
        setStatus(msg.consent, "error");
        return;
      }

      const ep = form.getAttribute("data-endpoint") || "";
      if (!ep) {
        setStatus(msg.desconectado, "error");
        return;
      }

      const dispositivo = /Android|iPhone|iPad|Mobile/i.test(navigator.userAgent)
        ? "Mobile"
        : "Desktop";
      const origen = window.location.pathname;

      loading = true;
      submitBtn.disabled = true;
      setStatus(msg.enviando, "neutral");

      try {
        const res = await fetch(ep, {
          method: "POST",
          body: JSON.stringify({ nombre, email, mensaje, dispositivo, origen }),
        });
        let ok = res.ok;
        try {
          const data = await res.json();
          if (data && typeof data.ok === "boolean") ok = data.ok;
        } catch {
          /* sin JSON */
        }
        if (ok) {
          setStatus(msg.ok, "ok");
          form.reset();
        } else {
          setStatus(msg.error, "error");
        }
      } catch (err) {
        setStatus(msg.error, "error");
      } finally {
        loading = false;
        submitBtn.disabled = false;
      }
    });
  }
</script>
