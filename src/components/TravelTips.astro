---
import SectionTitle from "./SectionTitle.astro";

interface Props {
  title: string;
  tips: string[];
}

const { title, tips } = Astro.props;
---

<section class="mx-auto w-full max-w-6xl px-5 py-10 lg:px-8 lg:py-14">
  <SectionTitle title={title} />
  <ul class="mt-8 grid gap-3 sm:grid-cols-2">
    {
      tips.map((tip) => (
        <li class="flex items-start gap-3 rounded-xl bg-tarjeta p-4 shadow-card">
          <span aria-hidden="true" class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-terracota text-white text-xs">
            ✓
          </span>
          <p class="text-sm leading-relaxed text-body">{tip}</p>
        </li>
      ))
    }
  </ul>
</section>
