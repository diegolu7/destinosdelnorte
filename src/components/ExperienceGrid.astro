---
import SectionTitle from "./SectionTitle.astro";
import ExperienceCard from "./ExperienceCard.astro";

interface Props {
  title: string;
  experiencias: {
    nombre: string;
    descripcion: string;
    icono: "aventura" | "cultura" | "gastronomia" | "naturaleza" | "bodegas" | "senderismo";
  }[];
}

const { title, experiencias } = Astro.props;
---

{
  experiencias.length > 0 && (
    <section class="mx-auto w-full max-w-6xl px-5 py-10 lg:px-8 lg:py-14">
      <SectionTitle title={title} />
      <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-6">
        {
          experiencias.map((experiencia) => (
            <ExperienceCard
              nombre={experiencia.nombre}
              descripcion={experiencia.descripcion}
              icono={experiencia.icono}
            />
          ))
        }
      </div>
    </section>
  )
}
