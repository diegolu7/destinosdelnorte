---
import { langFromPath, type Lang } from "../lib/i18n";
import { SUPPORT_URLS, supportCopy, supportPage } from "../lib/support";
import BankDetails from "./BankDetails.astro";

interface Props {
  size?: "compact" | "panel";
  location?: string;
}

const { size = "compact", location = "page" } = Astro.props;
const lang: Lang = langFromPath(Astro.url.pathname);
const c = supportCopy(lang);
const pageHref = supportPage(lang);
---

<div
  class={`rounded-2xl border border-border-card bg-tarjeta shadow-card ${
    size === "compact" ? "p-5 sm:p-6" : "p-6 text-center sm:p-10"
  }`}
>
  {size === "compact" ? (
    <>
      <p class="font-display text-lg font-bold text-navy">{c.compactTitle}</p>
      <p class="mt-2 text-sm leading-relaxed text-body">{c.compactBody}</p>
      <a
        href={pageHref}
        data-donation="apoyar-page"
        data-loc={location}
        class="mt-4 inline-flex items-center justify-center gap-1.5 rounded-lg bg-terracota px-6 py-3 text-sm font-semibold text-white shadow-button transition-colors duration-200 hover:bg-terracota-hover"
      >
        {c.cta}
        <span aria-hidden="true" class="text-white">♥</span>
      </a>
    </>
  ) : (
    <>
      <h2 class="font-display text-xl font-bold text-navy lg:text-2xl">{c.panelTitle}</h2>
      <p class="mx-auto mt-3 max-w-2xl text-sm leading-relaxed text-body lg:text-base">
        {c.panelBody}
      </p>
      <div class="mx-auto mt-6 max-w-xl space-y-3 text-left">
        <a
          href={SUPPORT_URLS.koFi}
          target="_blank"
          rel="noopener noreferrer"
          data-donation="ko-fi"
          data-loc={location}
          class="flex w-full items-center justify-center gap-1.5 rounded-lg bg-terracota px-6 py-3 text-sm font-semibold text-white shadow-button transition-colors duration-200 hover:bg-terracota-hover"
        >
          {c.koFiLabel}
          <span aria-hidden="true" class="text-white">♥</span>
        </a>
        <BankDetails />
      </div>
      <p class="mx-auto mt-4 max-w-xl text-xs leading-relaxed text-body-light">{c.note}</p>
    </>
  )}
</div>

<script>
  import confetti from "canvas-confetti";

  const reducedMotion =
    typeof window !== "undefined" &&
    window.matchMedia?.("(prefers-reduced-motion: reduce)")?.matches;

  function fireKoFi() {
    if (reducedMotion) return;
    confetti({
      particleCount: 110,
      spread: 75,
      startVelocity: 38,
      gravity: 0.9,
      scalar: 0.85,
      ticks: 170,
      origin: { y: 0.6 },
      colors: ["#D9553B", "#E11D48", "#F2A65A", "#1B2A4A", "#F7F5F1"],
    });
  }

  const providers = new Set(["ko-fi", "apoyar-page"]);
  document.querySelectorAll<HTMLAnchorElement>("[data-donation]").forEach((el) => {
    el.addEventListener("click", () => {
      const provider = el.dataset.donation ?? "";
      const loc = el.dataset.loc ?? "page";
      const lang = document.documentElement.lang || "es-AR";
      if (!providers.has(provider)) return;
      if (provider === "ko-fi") fireKoFi();
      if (typeof window !== "undefined" && typeof (window as any).gtag === "function") {
        (window as any).gtag("event", "donation_click", {
          donation_provider: provider,
          donation_location: loc,
          donation_lang: lang,
        });
      }
    });
  });
</script>
