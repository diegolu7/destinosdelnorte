---
import { langFromPath, type Lang } from "../lib/i18n";
import { SUPPORT_BANK, supportCopy } from "../lib/support";

const lang: Lang = langFromPath(Astro.url.pathname);
const c = supportCopy(lang);

const fields = [
  { key: "titular", label: c.bankTitular, value: SUPPORT_BANK.titular, copy: false },
  { key: "cuit", label: c.bankCuit, value: SUPPORT_BANK.cuit, copy: false },
  { key: "cvu", label: c.bankCvu, value: SUPPORT_BANK.cvu, copy: true },
  { key: "alias", label: c.bankAlias, value: SUPPORT_BANK.alias, copy: true },
];
---

<details class="group rounded-xl border border-border-card bg-header">
  <summary
    class="flex w-full cursor-pointer list-none items-center justify-between gap-3 rounded-lg bg-terracota px-6 py-3 text-sm font-semibold text-white shadow-button transition-colors duration-200 hover:bg-terracota-hover"
  >
    <span class="inline-flex items-center gap-1.5">
      {c.bankTitle}
      <span aria-hidden="true" class="text-white">♥</span>
    </span>
    <span aria-hidden="true" class="text-white/80 transition-transform duration-200 group-open:rotate-180">▾</span>
  </summary>

  <div class="space-y-2.5 px-5 py-4">
    <p class="text-xs leading-relaxed text-body-light">{c.bankNote}</p>
    {fields.map((f) => (
      <div class="flex items-center justify-between gap-3">
        <div class="min-w-0">
          <p class="text-[11px] font-medium uppercase tracking-wide text-body-light">{f.label}</p>
          <p class="break-all font-mono text-sm text-navy">{f.value}</p>
        </div>
        {f.copy && (
          <button
            type="button"
            data-copy={f.value}
            data-field={f.key}
            class="shrink-0 rounded-md border border-border-input px-2.5 py-1 text-xs font-medium text-navy transition-colors duration-150 hover:border-terracota hover:text-terracota"
          >
            {c.copyLabel}
          </button>
        )}
      </div>
    ))}
  </div>
</details>

<script>
  import confetti from "canvas-confetti";

  const reducedMotion =
    typeof window !== "undefined" &&
    window.matchMedia?.("(prefers-reduced-motion: reduce)")?.matches;

  function fireConfetti() {
    if (reducedMotion) return;
    confetti({
      particleCount: 60,
      spread: 60,
      startVelocity: 32,
      gravity: 0.9,
      scalar: 0.7,
      ticks: 150,
      origin: { y: 0.7 },
      colors: ["#D9553B", "#E11D48", "#F2A65A", "#1B2A4A", "#F7F5F1"],
    });
  }

  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const value = btn.dataset.copy ?? "";
      const original = btn.textContent ?? "";
      const done = () => {
        btn.textContent = "✓";
        window.setTimeout(() => {
          btn.textContent = original;
        }, 1600);
      };
      let copied = false;
      try {
        await navigator.clipboard.writeText(value);
        copied = true;
      } catch {
        const ta = document.createElement("textarea");
        ta.value = value;
        ta.style.position = "fixed";
        ta.style.opacity = "0";
        document.body.appendChild(ta);
        ta.select();
        try {
          copied = document.execCommand("copy");
        } catch {
          /* sin acción */
        }
        document.body.removeChild(ta);
      }
      if (copied) {
        done();
        fireConfetti();
        if (typeof window !== "undefined" && typeof (window as any).gtag === "function") {
          (window as any).gtag("event", "donation_copy", {
            donation_provider: "bank-transfer",
            donation_field: btn.dataset.field ?? "unknown",
          });
        }
      }
    });
  });
</script>
