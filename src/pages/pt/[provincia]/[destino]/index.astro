---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import DestinationHero from "../../../../components/DestinationHero.astro";
import PlacesGrid from "../../../../components/PlacesGrid.astro";
import ExperienceGrid from "../../../../components/ExperienceGrid.astro";
import TravelInfo from "../../../../components/TravelInfo.astro";
import TravelTips from "../../../../components/TravelTips.astro";
import DestinationMap from "../../../../components/DestinationMap.astro";
import Reviews from "../../../../components/Reviews.astro";
import RelatedGuides from "../../../../components/RelatedGuides.astro";
import RelatedDestinations from "../../../../components/RelatedDestinations.astro";
import SupportCta from "../../../../components/SupportCta.astro";
import { resolveImage as getImage } from "../../../../lib/images";

export async function getStaticPaths() {
  const destinos = await getCollection("destinosPt");
  return destinos.map((destino) => ({
    params: { provincia: destino.data.provincia, destino: destino.data.slug },
    props: { destino },
  }));
}

const { destino } = Astro.props;

const provincias = await getCollection("provinciasPt");
const provincia = provincias.find((p) => p.data.slug === destino.data.provincia)!;

const allDestinos = await getCollection("destinosPt");
const destinoBySlug = new Map(allDestinos.map((d) => [d.data.slug, d]));

const allExperiencias = await getCollection("experienciasPt");
const expById = new Map(allExperiencias.map((e) => [e.id, e]));
const experiencias = (destino.data.experiencias ?? [])
  .map((id) => expById.get(id))
  .filter((e): e is NonNullable<typeof e> => Boolean(e))
  .map((e) => ({ nombre: e.data.nombre, descripcion: e.data.descripcion, icono: e.data.icono }));

const allGuias = await getCollection("guiasPt");
const guiasDelDestino = allGuias
  .filter((g) => g.data.destino === destino.data.slug)
  .map((g) => ({
    titulo: g.data.titulo,
    descripcion: g.data.descripcion,
    href: `/pt/${provincia.data.slug}/${destino.data.slug}/${g.id.split("/").pop()}/`,
    tipo: g.data.tipo,
    fecha: g.data.fechaActualizacion
      ? new Intl.DateTimeFormat("pt-BR", { month: "short", year: "numeric" }).format(
          g.data.fechaActualizacion,
        )
      : undefined,
  }))
  .sort((a, b) => a.titulo.localeCompare(b.titulo, "pt"));

const destinosCercanos = (destino.data.destinosCercanos ?? [])
  .map((slug) => destinoBySlug.get(slug))
  .filter((d): d is NonNullable<typeof d> => Boolean(d))
  .map((d) => ({
    nombre: d.data.name,
    descripcion: d.data.descripcion,
    href: `/pt/${d.data.provincia}/${d.data.slug}/`,
    imagen: getImage(d.data.imagen),
  }));

const resenasData = (
  await import("../../../../data/resenas-pt.json")
).default as Record<
  string,
  {
    destino: string;
    fuente_resenas?: string;
    url_fuente_resenas?: string;
    resenas: { autor: string; fecha?: string; valoracion: number; texto: string }[];
  }
>;
const resenasEntry = resenasData[destino.data.slug];
const resenasDestino = (resenasEntry?.resenas ?? [])
  .map((rev) => ({
    autor: rev.autor,
    fecha: rev.fecha ? new Date(rev.fecha) : undefined,
    valoracion: rev.valoracion,
    texto: rev.texto,
  }))
  .slice(0, 5);

const fuenteResenas = resenasEntry?.fuente_resenas ?? "Google";
const urlFuenteRaw = resenasEntry?.url_fuente_resenas ?? "";
const urlFuente = (urlFuenteRaw.match(/\(([^)]+)\)/) ?? [])[1] ?? urlFuenteRaw;

const linkVerGoogle =
  destino.data.lat !== undefined && destino.data.lng !== undefined
    ? `https://www.google.com/maps/search/?api=1&query=${destino.data.lat},${destino.data.lng}`
    : `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(destino.data.name)}`;

const { Content } = await render(destino);

const title = `O que fazer em ${destino.data.name}: lugares para visitar | Destinos del Norte`;

const touristDestination = {
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  name: destino.data.name,
  description: destino.data.intro,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  image: new URL(getImage(destino.data.imagen).src, Astro.site).toString(),
};
---

<BaseLayout
  lang="pt"
  title={title}
  description={destino.data.descripcion}
  breadcrumbs={[
    { name: provincia.data.name, path: `/pt/${provincia.data.slug}/` },
    { name: destino.data.name, path: `/pt/${provincia.data.slug}/${destino.data.slug}/` },
  ]}
  jsonLd={[touristDestination]}
>
  <DestinationHero
    titulo={`O que fazer em ${destino.data.name}`}
    intro={destino.data.intro}
    provinciaName={provincia.data.name}
    provinciaHref={`/pt/${provincia.data.slug}/`}
    imagen={getImage(destino.data.imagen)}
    imagenAlt={destino.data.name}
    breadcrumbs={[
      { name: provincia.data.name, path: `/pt/${provincia.data.slug}/` },
      { name: destino.data.name, path: `/pt/${provincia.data.slug}/${destino.data.slug}/` },
    ]}
  />

  {
    destino.data.lugaresImperdibles && destino.data.lugaresImperdibles.length > 0 && (
      <PlacesGrid title="Lugares imperdíveis" places={destino.data.lugaresImperdibles} />
    )
  }

  <section class="mx-auto w-full max-w-6xl px-5 py-10 lg:px-8 lg:py-14">
    <div class="prose-norte max-w-3xl">
      <Content />
    </div>
  </section>

  <ExperienceGrid title="Experiências" experiencias={experiencias} />

  <TravelInfo
    title="Informações práticas"
    comoLlegar={destino.data.comoLlegar}
    mejorEpoca={destino.data.mejorEpoca}
    diasRecomendados={destino.data.diasRecomendados}
    dondeComer={destino.data.dondeComer}
    dondeAlojarse={destino.data.dondeAlojarse}
  />

  {
    destino.data.consejos && destino.data.consejos.length > 0 && (
      <TravelTips title="Dicas" tips={destino.data.consejos} />
    )
  }

  <Reviews
    reviews={resenasDestino}
    linkVerGoogle={urlFuente || linkVerGoogle}
    fuente={fuenteResenas}
  />

  {
    destino.data.lat !== undefined && destino.data.lng !== undefined && (
      <DestinationMap
        nombre={destino.data.name}
        provinciaName={provincia.data.name}
        lat={destino.data.lat}
        lng={destino.data.lng}
      />
    )
  }

  <RelatedGuides title="Guias relacionadas" guides={guiasDelDestino} />

  <RelatedDestinations
    title="Destinos próximos"
    linkLabel={`Ver ${provincia.data.name}`}
    linkHref={`/pt/${provincia.data.slug}/`}
    destinos={destinosCercanos}
  />

  <div class="mx-auto w-full max-w-6xl px-5 py-6 lg:px-8">
    <SupportCta location="destino" />
  </div>
</BaseLayout>
