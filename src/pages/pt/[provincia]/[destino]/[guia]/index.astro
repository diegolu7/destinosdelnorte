---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../../../components/Breadcrumbs.astro";

export async function getStaticPaths() {
  const guias = await getCollection("guiasPt");
  return guias.map((guia) => ({
    params: { provincia: guia.data.provincia, destino: guia.data.destino, guia: guia.id.split("/").pop()! },
    props: { guia },
  }));
}

const { guia } = Astro.props;
const guiaSlug = guia.id.split("/").pop()!;

const provincias = await getCollection("provinciasPt");
const provincia = provincias.find((p) => p.data.slug === guia.data.provincia)!;

const destinos = await getCollection("destinosPt");
const destino = destinos.find((d) => d.data.slug === guia.data.destino)!;

const { Content } = await render(guia);

const title = `${guia.data.titulo} | Destinos del Norte`;
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: guia.data.titulo,
  description: guia.data.descripcion,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  author: { "@type": "Organization", name: "Destinos del Norte" },
  publisher: { "@type": "Organization", name: "Destinos del Norte" },
};
---

<BaseLayout
  lang="pt"
  title={title}
  description={guia.data.descripcion}
  breadcrumbs={[
    { name: provincia.data.name, path: `/pt/${provincia.data.slug}/` },
    { name: destino.data.name, path: `/pt/${provincia.data.slug}/${destino.data.slug}/` },
    { name: guia.data.titulo, path: `/pt/${provincia.data.slug}/${destino.data.slug}/${guiaSlug}/` },
  ]}
  jsonLd={[articleSchema]}
>
  <section class="mx-auto w-full max-w-3xl px-5 py-8 lg:px-8 lg:py-12">
    <Breadcrumbs
      items={[
        { name: provincia.data.name, path: `/pt/${provincia.data.slug}/` },
        { name: destino.data.name, path: `/pt/${provincia.data.slug}/${destino.data.slug}/` },
        { name: guia.data.titulo, path: `/pt/${provincia.data.slug}/${destino.data.slug}/${guiaSlug}/` },
      ]}
    />
    <h1 class="mt-5 font-display text-3xl font-bold leading-tight text-navy lg:text-[42px]">
      {guia.data.titulo}
    </h1>
    <p class="mt-4 text-sm leading-relaxed text-body lg:text-base">{guia.data.descripcion}</p>
    <div class="prose-norte mt-8 max-w-none border-t border-border-card pt-6">
      <Content />
    </div>
    <a
      href={`/pt/${provincia.data.slug}/${destino.data.slug}/`}
      class="mt-8 inline-flex text-sm font-medium text-terracota hover:text-terracota-hover"
    >
      ← Voltar para {destino.data.name}
    </a>
  </section>
</BaseLayout>
