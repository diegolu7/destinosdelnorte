---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionTitle from "../../components/SectionTitle.astro";
import SupportCta from "../../components/SupportCta.astro";
import { supportCopy, supportButtons } from "../../lib/support";

const lang = "pt";
const c = supportCopy(lang);
const buttons = supportButtons(lang);
const providerLine: Record<string, string> = {
  "ko-fi": c.koFiLine,
  "bank-transfer": c.mpLine,
};
---

<BaseLayout
  lang="pt"
  title="Apoiar o projeto | Destinos del Norte"
  description="Apoie a Destinos del Norte com uma doação pontual (Ko‑fi ou Mercado Pago) e ajude a manter conteúdo gratuito e sem anúncios sobre Salta, Jujuy e Tucumán."
  breadcrumbs={[{ name: c.footer, path: "/pt/apoyar/" }]}
>
  <section class="mx-auto w-full max-w-6xl px-5 py-10 lg:px-8 lg:py-14">
    <div class="max-w-2xl">
      <span class="inline-flex rounded-full bg-terracota/10 px-3 py-1 text-xs font-semibold text-terracota">
        {c.footer}
      </span>
      <h1 class="mt-4 font-display text-3xl font-bold leading-tight text-navy lg:text-[42px] lg:leading-tight">
        {c.pageLeadTitle}
      </h1>
      <p class="mt-4 text-sm leading-relaxed text-body lg:text-base">{c.pageLeadBody}</p>
    </div>
  </section>

  <section class="mx-auto w-full max-w-3xl px-5 lg:px-8">
    <div class="rounded-2xl bg-tarjeta p-6 shadow-card">
      <SectionTitle title={c.valueTitle} />
      <ul class="mt-4 space-y-2">
        {c.values.map((value) => (
          <li class="flex items-start gap-2 text-sm leading-relaxed text-body">
            <span aria-hidden="true" class="mt-0.5 text-terracota">✓</span>
            <span>{value}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="mx-auto w-full max-w-3xl px-5 py-8 lg:px-8 lg:py-10">
    <SectionTitle title={c.howTitle} />
    <div class="mt-6 grid gap-3 sm:grid-cols-2">
      {buttons.map((b) => (
        <div class="rounded-xl bg-tarjeta p-5 shadow-card">
          <p class="font-display text-base font-semibold text-navy">{b.label}</p>
          <p class="mt-1 text-sm leading-relaxed text-body-light">{providerLine[b.key]}</p>
        </div>
      ))}
    </div>
    <div class="mt-6">
      <SupportCta size="panel" location="apoyar" />
    </div>
  </section>

  <section class="mx-auto w-full max-w-3xl px-5 lg:px-8">
    <div class="rounded-2xl bg-tarjeta p-6 shadow-card">
      <SectionTitle title={c.whatTitle} />
      <ul class="mt-4 space-y-2">
        {c.what.map((item) => (
          <li class="flex items-start gap-2 text-sm leading-relaxed text-body">
            <span aria-hidden="true" class="mt-0.5 text-terracota">✓</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="mx-auto w-full max-w-3xl px-5 py-8 lg:px-8 lg:py-10">
    <p class="text-sm leading-relaxed text-body-light">
      <strong class="font-semibold text-navy">{c.safeTitle} </strong>
      {c.safeBody}
    </p>
  </section>

  <section class="mx-auto w-full max-w-6xl px-5 py-10 text-center lg:px-8 lg:py-14">
    <h2 class="font-display text-2xl font-bold text-navy lg:text-3xl">{c.thanksTitle}</h2>
  </section>
</BaseLayout>
