---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import { t } from "../../../../lib/ui";
import { url } from "../../../../lib/site";

export async function getStaticPaths() {
  const rutas = await getCollection("rutasPt");
  return rutas.map((ruta) => ({
    params: { slug: ruta.id.split("/").pop()! },
    props: { ruta },
  }));
}

const { ruta } = Astro.props;
const lang = "pt";
const slug = ruta.id.split("/").pop()!;
const { Content } = await render(ruta);
const navRoutes = t(lang, "nav.rutas");

const title = `${ruta.data.titulo} | Destinos del Norte`;
const daysLabel = t(lang, "common.dias");

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: ruta.data.titulo,
  description: ruta.data.descripcion,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  author: { "@type": "Organization", name: "Destinos del Norte" },
  publisher: { "@type": "Organization", name: "Destinos del Norte" },
};
---

<BaseLayout
  lang="pt"
  title={title}
  description={ruta.data.descripcion}
  breadcrumbs={[
    { name: navRoutes, path: "/pt/rutas/" },
    { name: ruta.data.titulo, path: `/pt/rutas/${slug}/` },
  ]}
  jsonLd={[articleSchema]}
>
  <section class="mx-auto w-full max-w-3xl px-5 py-8 lg:px-8 lg:py-12">
    <Breadcrumbs
      items={[
        { name: navRoutes, path: "/pt/rutas/" },
        { name: ruta.data.titulo, path: `/pt/rutas/${slug}/` },
      ]}
    />

    <span class="mt-5 inline-flex rounded-full bg-terracota/10 px-3 py-1 text-xs font-semibold text-terracota">
      {ruta.data.dias} {daysLabel}
    </span>
    <h1 class="mt-4 font-display text-3xl font-bold leading-tight text-navy lg:text-[42px] lg:leading-tight">
      {ruta.data.titulo}
    </h1>
    <p class="mt-4 text-sm leading-relaxed text-body lg:text-base">{ruta.data.descripcion}</p>

    <div class="prose-norte mt-8 max-w-none border-t border-border-card pt-6">
      <Content />
    </div>

    <div class="mt-10">
      <a
        href={url("/pt/rutas/")}
        class="inline-flex items-center gap-1 text-sm font-medium text-terracota transition-colors duration-200 hover:text-terracota-hover"
      >
        <span class="rotate-180" aria-hidden="true">➔</span> Ver todas as rotas
      </a>
    </div>
  </section>
</BaseLayout>
