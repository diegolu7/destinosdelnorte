---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { t } from "../../../lib/ui";
import { url } from "../../../lib/site";

const lang = "pt";
const rutas = (await getCollection("rutasPt")).sort((a, b) => a.data.dias - b.data.dias);
const daysLabel = t(lang, "common.dias");
const navRoutes = t(lang, "nav.rutas");
---

<BaseLayout
  lang="pt"
  title="Rotas e roteiros pelo Norte Argentino | Destinos del Norte"
  description="Rotas e roteiros sugeridos para percorrer o Norte Argentino: Salta, Jujuy e Tucumán em 4, 5, 6 e 7 dias."
  breadcrumbs={[{ name: navRoutes, path: "/pt/rutas/" }]}
>
  <section class="mx-auto w-full max-w-6xl px-5 py-10 lg:px-8 lg:py-14">
    <div class="max-w-2xl">
      <span class="inline-flex rounded-full bg-terracota/10 px-3 py-1 text-xs font-semibold text-terracota">
        Planejamento
      </span>
      <h1 class="mt-4 font-display text-3xl font-bold leading-tight text-navy lg:text-[42px] lg:leading-tight">
        Rotas e roteiros
      </h1>
      <p class="mt-4 text-sm leading-relaxed text-body lg:text-base">
        Planos sugeridos para percorrer o Norte Argentino conforme o tempo disponível. Cada rota combina destinos, paisagens e experiências para montar sua viagem.
      </p>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {
        rutas.map((ruta) => {
          const slug = ruta.id.split("/").pop()!;
          return (
            <a
              href={url(`/pt/rutas/${slug}/`)}
              class="group rounded-2xl bg-tarjeta p-6 shadow-card transition-all duration-200 ease-out hover:-translate-y-1 hover:shadow-card-hover"
            >
              <span class="inline-flex rounded-full bg-terracota/10 px-3 py-1 text-xs font-semibold text-terracota">
                {ruta.data.dias} {daysLabel}
              </span>
              <h2 class="mt-3 font-display text-xl font-bold text-navy transition-colors duration-200 group-hover:text-terracota">
                {ruta.data.titulo}
              </h2>
              <p class="mt-2 text-sm leading-relaxed text-body-light">{ruta.data.descripcion}</p>
              <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-terracota">
                Ver roteiro <span aria-hidden="true">➔</span>
              </span>
            </a>
          );
        })
      }
    </div>
  </section>
</BaseLayout>
