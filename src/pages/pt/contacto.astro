---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactForm from "../../components/ContactForm.astro";
import Icon from "../../components/Icon.astro";
import { SITE } from "../../lib/site";
import { langFromPath, localeHref, type Lang } from "../../lib/i18n";

const lang: Lang = langFromPath(Astro.url.pathname);

const contactPage = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "Contato",
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  mainEntity: {
    "@type": "Organization",
    name: SITE.name,
    email: SITE.email,
    url: new URL(Astro.url.pathname, Astro.site).toString(),
    contactPoint: { "@type": "ContactPoint", contactType: "customer service", email: SITE.email },
  },
};
---

<BaseLayout
  lang="pt"
  title="Contato | Destinos del Norte"
  description="Escreva para nós com suas dúvidas sobre viagens, destinos e experiências do Norte Argentino. Respondemos rapidamente."
  breadcrumbs={[{ name: "Contato", path: "/pt/contacto/" }]}
  jsonLd={[contactPage]}
>
  <section class="mx-auto w-full max-w-6xl px-5 py-10 lg:px-8 lg:py-14">
    <div class="max-w-2xl">
      <span class="inline-flex rounded-full bg-terracota/10 px-3 py-1 text-xs font-semibold text-terracota">
        Contato
      </span>
      <h1 class="mt-4 font-display text-3xl font-bold leading-tight text-navy lg:text-[42px] lg:leading-tight">
        Vamos conversar
      </h1>
      <p class="mt-4 text-sm leading-relaxed text-body lg:text-base">
        Tem uma dúvida sobre algum destino, experiência ou o planejamento da sua viagem pelo Norte Argentino? Preencha o formulário e responderemos rapidamente.
      </p>
    </div>

    <div class="mt-10 grid gap-8 lg:grid-cols-5">
      <div class="lg:col-span-3">
        <ContactForm lang="pt" />
      </div>

      <aside class="lg:col-span-2">
        <div class="rounded-2xl bg-navy p-6 text-white shadow-card">
          <h2 class="font-display text-lg font-bold text-white">Informações de contato</h2>
          <p class="mt-2 text-sm leading-relaxed text-navy-secondary">
            Você também pode escrever diretamente por e-mail ou consultar nossas perguntas frequentes.
          </p>
          <div class="mt-5 space-y-3">
            <a href={`mailto:${SITE.email}`} class="flex items-center gap-3 text-sm font-medium text-white transition-colors duration-150 hover:text-terracota-light">
              <Icon name="send" size={18} class="shrink-0 text-terracota-light" />
              <span class="break-all">{SITE.email}</span>
            </a>
            <a href={localeHref("/preguntas-frecuentes/", lang)} class="flex items-center gap-3 text-sm font-medium text-white transition-colors duration-150 hover:text-terracota-light">
              <Icon name="chevron" size={18} class="shrink-0 -rotate-90 text-terracota-light" />
              Perguntas frequentes
            </a>
            <a href={localeHref("/sobre-nosotros/", lang)} class="flex items-center gap-3 text-sm font-medium text-white transition-colors duration-150 hover:text-terracota-light">
              <Icon name="chevron" size={18} class="shrink-0 -rotate-90 text-terracota-light" />
              Sobre nós
            </a>
          </div>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
