---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionTitle from "../../components/SectionTitle.astro";
import { resolveImage } from "../../lib/images";

const provincias = (await getCollection("provinciasEn")).sort((a, b) =>
  a.data.name.localeCompare(b.data.name, "en"),
);
const destinos = (await getCollection("destinosEn")).sort((a, b) =>
  a.data.name.localeCompare(b.data.name, "en"),
);

const expEn: Record<string, string> = {
  aventura: "Adventure",
  cultura: "Culture",
  gastronomia: "Food & wine",
  naturaleza: "Nature",
  bodegas: "Wineries",
  senderismo: "Hiking",
};
const experiencias = Object.values(expEn);

const hero = resolveImage("hero_img.webp");
---

<BaseLayout
  lang="en"
  title="Destinos del Norte | Salta, Jujuy and Tucumán"
  description="Discover the best of the Argentine Northwest: things to do in Salta, Jujuy and Tucumán, places to visit, experiences and travel guides."
>
  <section class="relative overflow-hidden">
    <img
      src={hero.src}
      alt="Landscape of the Argentine Northwest with mountains"
      width={1916}
      height={821}
      loading="eager"
      class="block h-auto w-full object-cover"
    />
    <div class="mx-auto w-full max-w-6xl px-5 py-10 lg:px-8 lg:py-14">
      <h1 class="max-w-2xl font-display text-3xl font-bold leading-tight text-navy lg:text-[42px]">
        Discover the best of the Argentine Northwest
      </h1>
      <p class="mt-4 max-w-xl text-sm leading-relaxed text-body lg:text-base">
        Colorful mountains, historic villages, living culture and experiences that will win you over.
      </p>
      <a
        href="/en/salta/"
        class="mt-7 inline-flex rounded-lg bg-terracota px-6 py-3 text-sm font-semibold text-white shadow-button transition-colors hover:bg-terracota-hover"
      >
        Explore Salta
      </a>
    </div>
  </section>

  <section>
    <div class="mx-auto w-full max-w-6xl px-5 py-10 lg:px-8 lg:py-14">
      <SectionTitle title="Things to do in each destination" />
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {
          provincias.map((p) => (
            <a
              href={`/en/${p.data.slug}/`}
              class="group relative block h-28 overflow-hidden rounded-2xl sm:aspect-[4/3] sm:h-auto"
            >
              <img
                src={resolveImage(p.data.imagen).src}
                alt={p.data.name}
                width={1448}
                height={1086}
                loading="lazy"
                class="absolute inset-0 h-full w-full object-cover"
              />
              <div aria-hidden="true" class="overlay-card absolute inset-0"></div>
              <p class="absolute inset-0 flex items-center px-4 font-display text-lg font-bold text-white">
                Things to do in {p.data.name}
              </p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section>
    <div class="mx-auto w-full max-w-6xl px-5 pb-10 lg:px-8 lg:pb-14">
      <SectionTitle title="Unmissable destinations of the North" />
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          destinos.map((d) => (
            <a
              href={`/en/${d.data.provincia}/${d.data.slug}/`}
              class="group rounded-xl bg-tarjeta p-5 shadow-card transition-all duration-200 hover:-translate-y-1 hover:shadow-card-hover"
            >
              <p class="font-display text-base font-semibold text-navy transition-colors group-hover:text-terracota">
                {d.data.name}
              </p>
              <p class="mt-1 text-xs leading-relaxed text-body-light">{d.data.descripcion}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section>
    <div class="mx-auto w-full max-w-6xl px-5 pb-16 lg:px-8 lg:pb-20">
      <SectionTitle title="Experiences you will love" />
      <div class="mt-8 flex flex-wrap gap-2">
        {experiencias.map((e) => (
          <span class="rounded-full bg-tarjeta px-4 py-1.5 text-sm font-medium text-navy shadow-card">
            {e}
          </span>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
