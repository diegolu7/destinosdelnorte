---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionTitle from "../../components/SectionTitle.astro";
import ProvinceCard from "../../components/ProvinceCard.astro";
import Icon from "../../components/Icon.astro";
import { resolveImage } from "../../lib/images";
import { SITE, url } from "../../lib/site";
import { langFromPath, type Lang } from "../../lib/i18n";

const lang: Lang = langFromPath(Astro.url.pathname);

const provincias = (await getCollection("provinciasEn")).sort((a, b) =>
  a.data.name.localeCompare(b.data.name, "es"),
);
const destinos = await getCollection("destinosEn");
const guias = await getCollection("guiasEn");

const numeros = [
  { valor: provincias.length, etiqueta: "Provinces" },
  { valor: destinos.length, etiqueta: "Destinations" },
  { valor: guias.length, etiqueta: "Travel guides" },
  { valor: 6, etiqueta: "Experiences" },
];

const oferta = [
  {
    icono: "pin" as const,
    titulo: "Destinations",
    texto: "Complete tourist landing pages for every place in the Argentine North.",
  },
  {
    icono: "arrow" as const,
    titulo: "Travel guides",
    texto: "How to get there, best time, tips and useful itineraries to plan your trip.",
  },
  {
    icono: "aventura" as const,
    titulo: "Experiences",
    texto: "Adventure, culture, gastronomy, nature, wineries and hiking.",
  },
  {
    icono: "search" as const,
    titulo: "Search",
    texto: "Find the perfect destination with instant suggestions.",
  },
];

const valores = [
  {
    titulo: "Useful, verified content",
    texto: "Clear and honest information so you can plan with confidence.",
  },
  {
    titulo: "Built for the traveler",
    texto: "Mobile-first, fast and easy to use on any device.",
  },
  {
    titulo: "SEO-first",
    texto: "Every page is designed to be found on search engines.",
  },
  {
    titulo: "Always growing",
    texto: "We keep adding destinations and content so you never run out of places to discover.",
  },
];

const aboutPage = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: "About us",
  description:
    "Destinos del Norte is a guide to discover the most amazing places in the Argentine North: Salta, Jujuy and Tucumán.",
  url: new URL(Astro.url.pathname, Astro.site).toString(),
};
---

<BaseLayout
  lang="en"
  title="About us | Destinos del Norte"
  description="Destinos del Norte is your guide to discover the Argentine North: destinations, travel guides and experiences in Salta, Jujuy and Tucumán."
  breadcrumbs={[{ name: "About us", path: "/en/sobre-nosotros/" }]}
  jsonLd={[aboutPage]}
>
  <section class="mx-auto w-full max-w-6xl px-5 py-10 lg:px-8 lg:py-14">
    <div class="max-w-2xl">
      <span class="inline-flex rounded-full bg-terracota/10 px-3 py-1 text-xs font-semibold text-terracota">
        About Destinos del Norte
      </span>
      <h1 class="mt-4 font-display text-3xl font-bold leading-tight text-navy lg:text-[42px] lg:leading-tight">
        Your guide to discovering the Argentine North
      </h1>
      <p class="mt-4 text-sm leading-relaxed text-body lg:text-base">
        We help travelers discover destinations, places and experiences in the North of Argentina, with useful, organized content so every trip is easier to plan.
      </p>
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-5 py-8 lg:px-8 lg:py-12">
    <div class="grid items-start gap-8 lg:grid-cols-2">
      <div class="rounded-2xl shadow-card overflow-hidden">
        <img
          src={resolveImage("seccion_atractivo_cerro_7_colores.webp").src}
          alt="Hill of Seven Colors in Purmamarca, Jujuy"
          width={1200}
          height={1100}
          loading="lazy"
          class="h-full w-full object-cover"
        />
      </div>
      <div>
        <SectionTitle title="What is Destinos del Norte?" />
        <p class="mt-6 text-sm leading-relaxed text-body lg:text-base">
          Destinos del Norte is a digital guide dedicated to the landscapes, towns and culture of Salta, Jujuy and Tucumán. We bring together in one place the information travelers need: what to do in each destination, the must-see places, how to get there, when to visit and what experiences to live.
        </p>
        <p class="mt-4 text-sm leading-relaxed text-body lg:text-base">
          Our goal is simple: making it easy, inspiring and memorable to discover the Argentine North, with clear, verified content designed to accompany you at every stage of the trip.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-5 py-8 lg:px-8 lg:py-12">
    <SectionTitle title="Destinos del Norte in numbers" />
    <div class="mt-8 grid grid-cols-2 gap-4 lg:grid-cols-4">
      {
        numeros.map((n) => (
          <div class="rounded-xl bg-tarjeta p-5 text-center shadow-card">
            <p class="font-display text-4xl font-bold text-terracota lg:text-5xl">{n.valor}</p>
            <p class="mt-1 text-sm font-medium text-body">{n.etiqueta}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-5 py-8 lg:px-8 lg:py-12">
    <SectionTitle title="What we offer" />
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        oferta.map((o) => (
          <div class="rounded-xl bg-tarjeta p-5 shadow-card transition-all duration-200 ease-out hover:-translate-y-1 hover:shadow-card-hover">
            <Icon name={o.icono} size={28} class="text-terracota" />
            <h3 class="mt-3 font-display text-base font-semibold text-navy">{o.titulo}</h3>
            <p class="mt-1 text-sm leading-relaxed text-body-light">{o.texto}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-5 py-8 lg:px-8 lg:py-12">
    <SectionTitle title="How we work" />
    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        valores.map((v) => (
          <div class="flex items-start gap-4 rounded-xl bg-tarjeta p-5 shadow-card">
            <span aria-hidden="true" class="mt-1 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-terracota text-white text-xs">
              ✓
            </span>
            <div>
              <h3 class="font-display text-base font-semibold text-navy">{v.titulo}</h3>
              <p class="mt-1 text-sm leading-relaxed text-body-light">{v.texto}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-5 py-8 lg:px-8 lg:py-12">
    <SectionTitle title="Explore the North" />
    <div class="mt-8 flex flex-col gap-3 sm:grid sm:grid-cols-3 sm:gap-5">
      {
        provincias.map((provincia) => (
          <ProvinceCard
            nombre={provincia.data.name}
            slug={provincia.data.slug}
            imagen={resolveImage(provincia.data.imagen)}
            lang={lang}
          />
        ))
      }
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-5 py-8 lg:px-8 lg:py-14">
    <div class="rounded-2xl bg-navy px-6 py-10 text-center lg:px-10">
      <h2 class="font-display text-2xl font-bold text-white lg:text-3xl">
        Ready to travel?
      </h2>
      <p class="mx-auto mt-3 max-w-xl text-sm text-navy-secondary lg:text-base">
        Explore the must-see destinations and start planning your next adventure through the Argentine North.
      </p>
      <a
        href={url("/en/#destinos")}
        class="mt-6 inline-flex items-center justify-center rounded-lg bg-terracota px-6 py-3 text-sm font-semibold text-white shadow-button transition-colors duration-200 hover:bg-terracota-hover"
      >
        Explore destinations
      </a>
      <p class="mt-5 text-sm text-navy-secondary">
        Any questions? Write to us at{" "}
        <a href={`mailto:${SITE.email}`} class="font-medium text-white underline underline-offset-2 transition-colors duration-150 hover:text-terracota-light">
          {SITE.email}
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
