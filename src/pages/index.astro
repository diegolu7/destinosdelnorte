---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SearchBar from "../components/SearchBar.astro";
import SectionTitle from "../components/SectionTitle.astro";
import ProvinceCard from "../components/ProvinceCard.astro";
import DestinationCard from "../components/DestinationCard.astro";
import ExperienceCard from "../components/ExperienceCard.astro";
import Icon from "../components/Icon.astro";
import { resolveImage as getImage } from "../lib/images";
import { url } from "../lib/site";

const provincias = (await getCollection("provincias")).sort((a, b) =>
  a.data.name.localeCompare(b.data.name, "es"),
);
const destinos = (await getCollection("destinos")).sort((a, b) =>
  a.data.name.localeCompare(b.data.name, "es"),
);
const experiencias = (await getCollection("experiencias")).sort((a, b) =>
  a.data.nombre.localeCompare(b.data.nombre, "es"),
);
---

<BaseLayout
  title="Destinos del Norte | Salta, Jujuy y Tucumán"
  description="Descubrí los mejores destinos del Norte Argentino: qué hacer en Salta, Jujuy y Tucumán, lugares para visitar, experiencias y guías de viaje."
>
  <Hero title="Explorá destinos" />

  <SearchBar />

  <section id="que-hacer" class="scroll-mt-24">
    <div class="mx-auto w-full max-w-6xl px-5 py-10 lg:px-8 lg:py-16">
      <SectionTitle title="¿Qué hacer en cada destino?" />
      <div class="mt-8 flex flex-col gap-3 sm:grid sm:grid-cols-3 sm:gap-5">
        {
          provincias.map((provincia) => (
            <ProvinceCard
              nombre={provincia.data.name}
              slug={provincia.data.slug}
              imagen={getImage(provincia.data.imagen)}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section id="destinos" class="scroll-mt-24">
    <div class="mx-auto w-full max-w-6xl px-5 pb-10 lg:px-8 lg:pb-16">
      <div class="flex items-end justify-between gap-4">
        <SectionTitle title="Destinos imperdibles del Norte" />
        <a href={url("/salta/")} class="hidden shrink-0 pb-1 text-sm font-medium text-terracota transition-colors duration-200 hover:text-terracota-hover lg:inline-flex">
          Ver todos los destinos
        </a>
      </div>
      <div class="relative mt-8">
        <div id="destinos-viewport" data-count={destinos.length} class="overflow-hidden">
          <div id="destinos-track" class="flex gap-4" style="transform: translateX(0);">
            {
              destinos.map((destino) => (
                <DestinationCard
                  nombre={destino.data.name}
                  descripcion={destino.data.descripcion}
                  href={`/${destino.data.provincia}/${destino.data.slug}/`}
                  imagen={getImage(destino.data.imagen)}
                  extraClass="w-[72%] shrink-0 sm:w-[46%] lg:w-[31%] xl:w-[24%]"
                />
              ))
            }
          </div>
        </div>
        <button
          id="destinos-prev"
          type="button"
          aria-label="Destino anterior"
          class="absolute -left-2 top-1/2 z-10 inline-flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-white text-navy shadow-card transition-transform duration-200 hover:scale-110 lg:-left-3"
        >
          <span class="rotate-180">
            <Icon name="arrow" size={20} />
          </span>
        </button>
        <button
          id="destinos-next"
          type="button"
          aria-label="Destino siguiente"
          class="absolute -right-2 top-1/2 z-10 inline-flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-white text-navy shadow-card transition-transform duration-200 hover:scale-110 lg:-right-3"
        >
          <Icon name="arrow" size={20} />
        </button>
      </div>
      <div id="destinos-dots" class="mt-5 flex items-center justify-center gap-2">
        {
          destinos.map((_, i) => (
            <button
              type="button"
              data-dot={i}
              aria-label={`Ir al destino ${i + 1}`}
              class={`h-2.5 w-2.5 rounded-full transition-colors duration-300 ${
                i === 0 ? "bg-navy" : "bg-navy/20"
              }`}
            ></button>
          ))
        }
      </div>
      <a href={url("/salta/")} class="mt-5 inline-flex text-sm font-medium text-terracota transition-colors duration-200 hover:text-terracota-hover lg:hidden">
        Ver todos
      </a>
    </div>
  </section>

  <section id="experiencias" class="scroll-mt-24">
    <div class="mx-auto w-full max-w-6xl px-5 pb-16 lg:px-8 lg:pb-24">
      <div class="flex items-end justify-between gap-4">
        <SectionTitle title="Experiencias que te van a encantar" />
        <a href={url("/jujuy/")} class="hidden shrink-0 pb-1 text-sm font-medium text-terracota transition-colors duration-200 hover:text-terracota-hover lg:inline-flex">
          Ver todas las experiencias
        </a>
      </div>
      <div class="mt-8 grid grid-cols-4 gap-2 sm:gap-8">
        {
          experiencias.map((experiencia) => (
            <ExperienceCard
              nombre={experiencia.data.nombre}
              descripcion={experiencia.data.descripcion}
              icono={experiencia.data.icono}
            />
          ))
        }
      </div>
      <a href={url("/jujuy/")} class="mt-5 inline-flex text-sm font-medium text-terracota transition-colors duration-200 hover:text-terracota-hover lg:hidden">
        Ver todas
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  const viewport = document.getElementById("destinos-viewport");
  const track = document.getElementById("destinos-track");
  const prevBtn = document.getElementById("destinos-prev");
  const nextBtn = document.getElementById("destinos-next");
  const dotBtns = Array.from(document.querySelectorAll("#destinos-dots [data-dot]"));

  if (viewport && track) {
    const count = Number(viewport.getAttribute("data-count")) || 0;
    const GAP = 16;
    let index = 0;
    let timer;

    function unit() {
      const card = track.firstElementChild;
      return card ? card.offsetWidth + GAP : 0;
    }

    function updateDots() {
      dotBtns.forEach((d, i) => {
        const on = i === index;
        d.classList.toggle("bg-navy", on);
        d.classList.toggle("bg-navy/20", !on);
      });
    }

    function animateTo(i, animated) {
      index = i;
      track.style.transition = animated ? "transform 500ms ease-in-out" : "none";
      track.style.transform = "translateX(" + -index * unit() + "px)";
      updateDots();
    }

    function go(dir) {
      stopAutoplay();
      const target =
        dir === 1 ? (index === count - 1 ? 0 : index + 1) : index === 0 ? count - 1 : index - 1;
      const wrap = (target === 0 && index === count - 1) || (target === count - 1 && index === 0);
      animateTo(target, !wrap);
      startAutoplay();
    }

    function startAutoplay() {
      if (timer) window.clearInterval(timer);
      timer = window.setInterval(() => {
        const target = index === count - 1 ? 0 : index + 1;
        animateTo(target, target !== 0);
      }, 3500);
    }

    function stopAutoplay() {
      if (timer) {
        window.clearInterval(timer);
        timer = undefined;
      }
    }

    prevBtn?.addEventListener("click", () => go(-1));
    nextBtn?.addEventListener("click", () => go(1));

    dotBtns.forEach((d) => {
      d.addEventListener("click", () => {
        stopAutoplay();
        const target = Number(d.dataset.dot);
        animateTo(target, Math.abs(target - index) <= 2);
        startAutoplay();
      });
    });

    viewport.addEventListener("mouseenter", stopAutoplay);
    viewport.addEventListener("mouseleave", startAutoplay);
    viewport.addEventListener("touchstart", stopAutoplay, { passive: true });
    viewport.addEventListener("touchend", () => setTimeout(startAutoplay, 3500));

    let startX = null;
    viewport.addEventListener("pointerdown", (e) => {
      startX = e.clientX;
      stopAutoplay();
    });
    viewport.addEventListener("pointerup", (e) => {
      if (startX === null) return;
      const dx = e.clientX - startX;
      startX = null;
      if (Math.abs(dx) > 40) go(dx < 0 ? 1 : -1);
      else startAutoplay();
    });

    let rTimer;
    window.addEventListener("resize", () => {
      window.clearTimeout(rTimer);
      rTimer = window.setTimeout(() => animateTo(index, false), 150);
    });

    animateTo(0, false);
    startAutoplay();
  }
</script>
