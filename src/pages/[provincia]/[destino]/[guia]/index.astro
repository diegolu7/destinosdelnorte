---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import RelatedGuides from "../../../../components/RelatedGuides.astro";
import { url } from "../../../../lib/site";
import { resolveImage as getImage } from "../../../../lib/images";

export async function getStaticPaths() {
  const guias = await getCollection("guias");
  return guias.map((guia) => ({
    params: {
      provincia: guia.data.provincia,
      destino: guia.data.destino,
      guia: guia.id.split("/").pop()!,
    },
    props: { guia },
  }));
}

const { guia } = Astro.props;

const guiaSlug = guia.id.split("/").pop()!;

const provincias = (await getCollection("provincias")).filter((p) => p.data.lang === "es");
const provincia = provincias.find((p) => p.data.slug === guia.data.provincia)!;

const destinos = await getCollection("destinos");
const destino = destinos.find((d) => d.data.slug === guia.data.destino)!;

const otrasGuias = (await getCollection("guias"))
  .filter((g) => g.data.destino === guia.data.destino && g.id.split("/").pop() !== guiaSlug)
  .map((g) => ({
    titulo: g.data.titulo,
    descripcion: g.data.descripcion,
    href: `/${provincia.data.slug}/${destino.data.slug}/${g.id.split("/").pop()}/`,
    tipo: g.data.tipo,
    fecha: g.data.fechaActualizacion
      ? new Intl.DateTimeFormat("es-AR", { month: "short", year: "numeric" }).format(
          g.data.fechaActualizacion,
        )
      : undefined,
  }))
  .sort((a, b) => a.titulo.localeCompare(b.titulo, "es"));

const imagenName = guia.data.imagen ?? destino.data.imagen;

const { Content } = await render(guia);

const title = `${guia.data.titulo} | Destinos del Norte`;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: guia.data.titulo,
  description: guia.data.descripcion,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  image: new URL(getImage(imagenName).src, Astro.site).toString(),
  dateModified: guia.data.fechaActualizacion,
  author: { "@type": "Organization", name: "Destinos del Norte" },
  publisher: { "@type": "Organization", name: "Destinos del Norte" },
};
---

<BaseLayout
  title={title}
  description={guia.data.descripcion}
  breadcrumbs={[
    { name: provincia.data.name, path: `/${provincia.data.slug}/` },
    { name: destino.data.name, path: `/${provincia.data.slug}/${destino.data.slug}/` },
    { name: guia.data.titulo, path: `/${provincia.data.slug}/${destino.data.slug}/${guiaSlug}/` },
  ]}
  jsonLd={[articleSchema]}
>
  <section class="mx-auto w-full max-w-3xl px-5 py-8 lg:px-8 lg:py-12">
    <Breadcrumbs
      items={[
        { name: provincia.data.name, path: `/${provincia.data.slug}/` },
        { name: destino.data.name, path: `/${provincia.data.slug}/${destino.data.slug}/` },
        { name: guia.data.titulo, path: `/${provincia.data.slug}/${destino.data.slug}/${guiaSlug}/` },
      ]}
    />

    <a
      href={url(`/${provincia.data.slug}/${destino.data.slug}/`)}
      class="mt-5 inline-flex items-center gap-1.5 rounded-full bg-terracota/10 px-3 py-1 text-xs font-semibold text-terracota transition-colors duration-200 hover:bg-terracota/20"
    >
      {destino.data.name}
    </a>

    <h1 class="mt-4 font-display text-3xl font-bold leading-tight text-navy lg:text-[42px]">
      {guia.data.titulo}
    </h1>
    <p class="mt-4 text-sm leading-relaxed text-body lg:text-base">{guia.data.descripcion}</p>

    <div class="mt-8 border-t border-border-card pt-6">
      <div class="prose-norte">
        <Content />
      </div>
    </div>

    <a
      href={url(`/${provincia.data.slug}/${destino.data.slug}/`)}
      class="mt-8 inline-flex text-sm font-medium text-terracota transition-colors duration-200 hover:text-terracota-hover"
    >
      ← Volver a {destino.data.name}
    </a>
  </section>

  <RelatedGuides title="Otras guías de este destino" guides={otrasGuias} />
</BaseLayout>
