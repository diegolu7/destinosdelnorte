---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import DestinationCard from "../../components/DestinationCard.astro";
import { resolveImage as getImage } from "../../lib/images";

export async function getStaticPaths() {
  const provincias = (await getCollection("provincias")).filter((p) => p.data.lang === "es");
  return provincias.map((provincia) => ({
    params: { provincia: provincia.data.slug },
    props: { provincia },
  }));
}

const { provincia } = Astro.props;

const destinos = (await getCollection("destinos"))
  .filter((destino) => destino.data.provincia === provincia.data.slug)
  .sort((a, b) => a.data.name.localeCompare(b.data.name, "es"));

const { Content } = await render(provincia);

const title = `Qué hacer en ${provincia.data.name}: lugares para visitar | Destinos del Norte`;

const touristDestination = {
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  name: provincia.data.name,
  description: provincia.data.intro,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  image: new URL(getImage(provincia.data.imagen).src, Astro.site).toString(),
};
---

<BaseLayout
  title={title}
  description={provincia.data.descripcion}
  breadcrumbs={[{ name: provincia.data.name, path: `/${provincia.data.slug}/` }]}
  jsonLd={[touristDestination]}
>
  <section class="mx-auto w-full max-w-6xl px-5 py-8 lg:px-8 lg:py-12">
    <Breadcrumbs items={[{ name: provincia.data.name, path: `/${provincia.data.slug}/` }]} />

    <h1 class="mt-4 font-display text-3xl font-bold text-navy lg:text-[42px] lg:leading-tight">
      Qué hacer en {provincia.data.name}
    </h1>

    <p class="mt-4 max-w-3xl text-sm leading-relaxed text-body lg:text-base">
      {provincia.data.intro}
    </p>

    <div class="mt-10">
      <h2 class="font-display text-xl font-bold text-navy lg:text-2xl">
        Destinos destacados
      </h2>
      <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
        {
          destinos.map((destino) => (
            <DestinationCard
              nombre={destino.data.name}
              descripcion={destino.data.descripcion}
              href={`/${provincia.data.slug}/${destino.data.slug}/`}
              imagen={getImage(destino.data.imagen)}
            />
          ))
        }
      </div>
    </div>

    <div class="prose-norte mt-10 max-w-3xl lg:mt-12">
      <Content />
    </div>
  </section>
</BaseLayout>
