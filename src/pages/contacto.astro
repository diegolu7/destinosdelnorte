---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import Icon from "../components/Icon.astro";
import { SITE } from "../lib/site";

const contactPage = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "Contacto",
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  mainEntity: {
    "@type": "Organization",
    name: SITE.name,
    email: SITE.email,
    url: new URL(Astro.url.pathname, Astro.site).toString(),
    contactPoint: { "@type": "ContactPoint", contactType: "customer service", email: SITE.email },
  },
};
---

<BaseLayout
  title="Contacto | Destinos del Norte"
  description="Escribinos tus consultas sobre viajes, destinos y experiencias del Norte Argentino. Te respondemos a la brevedad."
  breadcrumbs={[{ name: "Contacto", path: "/contacto/" }]}
  jsonLd={[contactPage]}
>
  <section class="mx-auto w-full max-w-6xl px-5 py-10 lg:px-8 lg:py-14">
    <div class="max-w-2xl">
      <span class="inline-flex rounded-full bg-terracota/10 px-3 py-1 text-xs font-semibold text-terracota">
        Contacto
      </span>
      <h1 class="mt-4 font-display text-3xl font-bold leading-tight text-navy lg:text-[42px] lg:leading-tight">
        Hablemos
      </h1>
      <p class="mt-4 text-sm leading-relaxed text-body lg:text-base">
        ¿Tenés una consulta sobre algún destino, experiencia o planificación de tu viaje por el Norte Argentino? Completá el formulario y te respondemos a la brevedad.
      </p>
    </div>

    <div class="mt-10 grid gap-8 lg:grid-cols-5">
      <div class="lg:col-span-3">
        <ContactForm />
      </div>

      <aside class="lg:col-span-2">
        <div class="rounded-2xl bg-navy p-6 text-white shadow-card">
          <h2 class="font-display text-lg font-bold text-white">Información de contacto</h2>
          <p class="mt-2 text-sm leading-relaxed text-navy-secondary">
            También podés escribirnos directo por email o consultar nuestras guías frecuentes.
          </p>
          <div class="mt-5 space-y-3">
            <a href={`mailto:${SITE.email}`} class="flex items-center gap-3 text-sm font-medium text-white transition-colors duration-150 hover:text-terracota-light">
              <Icon name="send" size={18} class="shrink-0 text-terracota-light" />
              <span class="break-all">{SITE.email}</span>
            </a>
            <a href="/preguntas-frecuentes/" class="flex items-center gap-3 text-sm font-medium text-white transition-colors duration-150 hover:text-terracota-light">
              <Icon name="chevron" size={18} class="shrink-0 -rotate-90 text-terracota-light" />
              Preguntas frecuentes
            </a>
            <a href="/sobre-nosotros/" class="flex items-center gap-3 text-sm font-medium text-white transition-colors duration-150 hover:text-terracota-light">
              <Icon name="chevron" size={18} class="shrink-0 -rotate-90 text-terracota-light" />
              Sobre nosotros
            </a>
          </div>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
