---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
import Icon from "../components/Icon.astro";
import { url } from "../lib/site";

const faqs = (await getCollection("faqs")).sort((a, b) => {
  const c = a.data.categoria.localeCompare(b.data.categoria, "es");
  return c !== 0 ? c : a.data.pregunta.localeCompare(b.data.pregunta, "es");
});

const categorias = [...new Set(faqs.map((f) => f.data.categoria))];

const faqsRender = await Promise.all(
  faqs.map(async (faq) => ({ faq, Content: (await render(faq)).Content })),
);

const faqsPorCategoria = categorias.map((cat) => ({
  categoria: cat,
  items: faqsRender.filter(({ faq }) => faq.data.categoria === cat),
}));

function plainText(md: string): string {
  return md
    .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
    .replace(/\*\*|__/g, "")
    .replace(/[#>*_`]/g, "")
    .replace(/\s+/g, " ")
    .trim();
}

const faqPageSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.data.pregunta,
    acceptedAnswer: { "@type": "Answer", text: plainText(f.body ?? "") },
  })),
};
---

<BaseLayout
  title="Preguntas frecuentes | Destinos del Norte"
  description="Respuestas a las dudas más comunes para viajar por el Norte Argentino: cómo llegar, mejor época, clima, destinos, experiencias y consejos para Salta, Jujuy y Tucumán."
  breadcrumbs={[{ name: "Preguntas frecuentes", path: "/preguntas-frecuentes/" }]}
  jsonLd={[faqPageSchema]}
>
  <section class="mx-auto w-full max-w-6xl px-5 py-10 lg:px-8 lg:py-14">
    <div class="max-w-2xl">
      <span class="inline-flex rounded-full bg-terracota/10 px-3 py-1 text-xs font-semibold text-terracota">
        Ayuda y consejos
      </span>
      <h1 class="mt-4 font-display text-3xl font-bold leading-tight text-navy lg:text-[42px] lg:leading-tight">
        Preguntas frecuentes
      </h1>
      <p class="mt-4 text-sm leading-relaxed text-body lg:text-base">
        Resolvemos las dudas más comunes para viajar por el Norte Argentino. Si no encontrás tu respuesta, explorá los destinos y las guías para más detalles.
      </p>
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-5 pb-4 lg:px-8">
    <div class="flex flex-wrap gap-2">
      {
        categorias.map((cat) => (
          <a
            href={`#${cat.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`}
            class="rounded-full bg-tarjeta px-4 py-1.5 text-sm font-medium text-navy shadow-card transition-colors duration-150 hover:text-terracota"
          >
            {cat}
          </a>
        ))
      }
    </div>
  </section>

  {
    faqsPorCategoria.map(({ categoria, items }) => (
      <section id={categoria.toLowerCase().replace(/[^a-z0-9]+/g, "-")} class="scroll-mt-24">
        <div class="mx-auto w-full max-w-3xl px-5 py-8 lg:px-8 lg:py-10">
          <SectionTitle title={categoria} />
          <div class="mt-6 divide-y divide-border-card overflow-hidden rounded-2xl bg-tarjeta shadow-card">
            {
              items.map(({ faq, Content }) => (
                <details class="group px-5 py-4">
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-1">
                    <h2 class="font-display text-base font-semibold leading-snug text-navy">
                      {faq.data.pregunta}
                    </h2>
                    <Icon
                      name="chevron"
                      size={20}
                      class="shrink-0 text-terracota transition-transform duration-200 group-open:rotate-180"
                    />
                  </summary>
                  <div class="prose-norte mt-3 max-w-none">
                    <Content />
                  </div>
                </details>
              ))
            }
          </div>
        </div>
      </section>
    ))
  }

  <section class="mx-auto w-full max-w-6xl px-5 py-8 lg:px-8 lg:py-12">
    <div class="rounded-2xl bg-navy px-6 py-10 text-center lg:px-10">
      <h2 class="font-display text-2xl font-bold text-white lg:text-3xl">
        ¿Tenés otra duda?
      </h2>
      <p class="mx-auto mt-3 max-w-xl text-sm text-navy-secondary lg:text-base">
        Explorá los destinos imperdibles y sus guías para encontrar toda la información que necesitás para tu viaje.
      </p>
      <a
        href={url("/#destinos")}
        class="mt-6 inline-flex items-center justify-center rounded-lg bg-terracota px-6 py-3 text-sm font-semibold text-white shadow-button transition-colors duration-200 hover:bg-terracota-hover"
      >
        Explorá destinos
      </a>
    </div>
  </section>
</BaseLayout>
