---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { url } from "../../lib/site";

const articulos = (await getCollection("blog")).sort(
  (a, b) => b.data.fecha.getTime() - a.data.fecha.getTime(),
);
---

<BaseLayout
  title="Blog | Destinos del Norte"
  description="Artículos y guías para viajar por el Norte Argentino: atractivos gratuitos, consejos y planes para Salta, Jujuy y Tucumán."
  breadcrumbs={[{ name: "Blog", path: "/blog/" }]}
>
  <section class="mx-auto w-full max-w-6xl px-5 py-10 lg:px-8 lg:py-14">
    <div class="max-w-2xl">
      <span class="inline-flex rounded-full bg-terracota/10 px-3 py-1 text-xs font-semibold text-terracota">
        Blog
      </span>
      <h1 class="mt-4 font-display text-3xl font-bold leading-tight text-navy lg:text-[42px] lg:leading-tight">
        Blog y guías del Norte
      </h1>
      <p class="mt-4 text-sm leading-relaxed text-body lg:text-base">
        Artículos y guías con consejos, atractivos gratuitos y planes para aprovechar al máximo el Norte Argentino.
      </p>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        articulos.map((articulo) => {
          const slug = articulo.id.split("/").pop()!;
          return (
            <a
              href={url(`/blog/${slug}/`)}
              class="group flex flex-col rounded-2xl bg-tarjeta p-6 shadow-card transition-all duration-200 ease-out hover:-translate-y-1 hover:shadow-card-hover"
            >
              <div class="flex items-center justify-between gap-3">
                <span class="inline-flex rounded-full bg-terracota/10 px-3 py-1 text-xs font-semibold text-terracota">
                  {articulo.data.categoria ?? "Blog"}
                </span>
                <span class="text-xs text-body-light">
                  {new Intl.DateTimeFormat("es-AR", { month: "short", year: "numeric" }).format(
                    articulo.data.fecha,
                  )}
                </span>
              </div>
              <h2 class="mt-3 font-display text-lg font-bold text-navy transition-colors duration-200 group-hover:text-terracota">
                {articulo.data.titulo}
              </h2>
              <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-body-light">
                {articulo.data.descripcion}
              </p>
              <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-terracota">
                Leer artículo <span aria-hidden="true">➔</span>
              </span>
            </a>
          );
        })
      }
    </div>
  </section>
</BaseLayout>
